@using WikiWikiWorld.Web
@namespace WikiWikiWorld.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* Shared UI text keyed by the English wording (see SharedResource): L for plain text, HL when a translation
   contains markup placeholders. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> HL
