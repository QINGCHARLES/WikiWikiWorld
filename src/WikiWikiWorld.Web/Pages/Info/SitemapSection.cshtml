@page
@model WikiWikiWorld.Web.Pages.Info.SitemapSectionModel
@using WikiWikiWorld.Web.Pages.Info
@{
	HtmlSitemapSectionPage SectionPage = Model.SectionPage;
}

<div class="sitemap-page">
	<nav class="sitemap-breadcrumb" aria-label="@L["Breadcrumb"]">
		<a href="/info:sitemap">@L["Sitemap"]</a>
		<span aria-hidden="true">/</span>
		@if (SectionPage.ActiveBucket is not null || SectionPage.PageNumber > 1)
		{
			<a href="@SitemapSectionModel.BuildPageUrl(SectionPage.Section.Slug, null)">@L[SectionPage.Section.Title]</a>
		}
		else
		{
			<span aria-current="page">@L[SectionPage.Section.Title]</span>
		}
		@if (SectionPage.ActiveBucket is not null)
		{
			<span aria-hidden="true">/</span>
			if (SectionPage.PageNumber > 1)
			{
				<a href="@SitemapSectionModel.BuildPageUrl(SectionPage.Section.Slug, SectionPage.ActiveBucket.Slug)">@L[SectionPage.ActiveBucket.Label]</a>
			}
			else
			{
				<span aria-current="page">@L[SectionPage.ActiveBucket.Label]</span>
			}
		}
		@if (SectionPage.PageNumber > 1)
		{
			<span aria-hidden="true">/</span>
			<span aria-current="page">@L["Page {0}", SectionPage.PageNumber]</span>
		}
	</nav>

	<header class="sitemap-header">
		<div class="sitemap-section-head">
			<div>
				<h1>
					@L[SectionPage.Section.Title]
					@if (SectionPage.ActiveBucket is not null)
					{
						<span class="sitemap-bucket-tag">— @L[SectionPage.ActiveBucket.Label]</span>
					}
				</h1>
				<p class="sitemap-subtitle">
					@L[SharedResource.PluralPattern("Sitemap.Entries", SectionPage.TotalItems), SectionPage.TotalItems.ToString("N0")]
					@if (SectionPage.TotalPages > 1)
					{
						<span>&middot; @L["Page {0} of {1}", SectionPage.PageNumber, SectionPage.TotalPages]</span>
					}
				</p>
			</div>
		</div>

		<nav class="sitemap-buckets" aria-label="@L["Filter by starting letter"]">
			@if (SectionPage.ActiveBucket is null)
			{
				<span class="sitemap-bucket sitemap-bucket-all is-active" aria-current="page">@L["All"]</span>
			}
			else
			{
				<a class="sitemap-bucket sitemap-bucket-all" href="@SitemapSectionModel.BuildPageUrl(SectionPage.Section.Slug, null)">@L["All"]</a>
			}

			@foreach (SitemapBucketLink Bucket in SectionPage.Buckets)
			{
				if (SectionPage.ActiveBucket?.Slug == Bucket.Slug)
				{
					<span class="sitemap-bucket is-active" aria-current="page">@L[Bucket.Label]</span>
				}
				else if (Bucket.HasEntries)
				{
					<a class="sitemap-bucket" href="@SitemapSectionModel.BuildPageUrl(SectionPage.Section.Slug, Bucket.Slug)">@L[Bucket.Label]</a>
				}
				else
				{
					<span class="sitemap-bucket is-empty" aria-disabled="true">@L[Bucket.Label]</span>
				}
			}
		</nav>
	</header>

	@if (SectionPage.Entries.Count == 0)
	{
		<p class="sitemap-empty">@L["No entries found for this filter."]</p>
	}
	else
	{
		<ul class="sitemap-link-grid">
			@foreach (HtmlSitemapEntry Entry in SectionPage.Entries)
			{
				<li><a href="@Entry.Path">@Entry.Title</a></li>
			}
		</ul>
	}

	@if (SectionPage.TotalPages > 1)
	{
		<nav class="sitemap-pagination" aria-label="@L["Sitemap pagination"]">
			<div class="sitemap-page-step">
				@if (SectionPage.PageNumber > 1)
				{
					<a rel="prev" href="@SitemapSectionModel.BuildPageUrl(SectionPage.Section.Slug, SectionPage.ActiveBucket?.Slug, SectionPage.PageNumber - 1)">&larr; @L["Previous"]</a>
				}
			</div>

			<ol class="sitemap-page-numbers">
				@foreach (int? Token in Model.PaginationTokens)
				{
					if (Token is null)
					{
						<li class="sitemap-ellipsis" aria-hidden="true">&hellip;</li>
					}
					else if (Token.Value == SectionPage.PageNumber)
					{
						<li><span class="is-current" aria-current="page">@Token.Value</span></li>
					}
					else
					{
						<li>
							<a href="@SitemapSectionModel.BuildPageUrl(SectionPage.Section.Slug, SectionPage.ActiveBucket?.Slug, Token.Value)">@Token.Value</a>
						</li>
					}
				}
			</ol>

			<div class="sitemap-page-step">
				@if (SectionPage.PageNumber < SectionPage.TotalPages)
				{
					<a rel="next" href="@SitemapSectionModel.BuildPageUrl(SectionPage.Section.Slug, SectionPage.ActiveBucket?.Slug, SectionPage.PageNumber + 1)">@L["Next"] &rarr;</a>
				}
			</div>
		</nav>
	}
</div>
