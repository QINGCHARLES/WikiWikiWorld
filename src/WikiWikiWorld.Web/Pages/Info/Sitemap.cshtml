@page
@model WikiWikiWorld.Web.Pages.Info.SitemapModel
@{
	ViewData["Title"] = "Sitemap";
}

<div class="sitemap-page">
	<header class="sitemap-header">
		<h1>Sitemap</h1>
		<p class="sitemap-subtitle">
			Browse @Model.Hub.TotalContentCount.ToString("N0") indexed entries on @Model.SiteName (@Model.Culture),
			or fetch the machine-readable <a href="/sitemap.xml">XML sitemap</a>.
		</p>
	</header>

	<section class="sitemap-section" aria-labelledby="sitemap-site-pages">
		<div class="sitemap-section-head">
			<h2 id="sitemap-site-pages">Site Pages</h2>
		</div>
		<ul class="sitemap-link-grid">
			@foreach (SitemapStaticLink StaticLink in Model.Hub.StaticLinks)
			{
				<li><a href="@StaticLink.Path">@StaticLink.Label</a></li>
			}
			<li><a href="/sitemap.xml">XML Sitemap</a></li>
		</ul>
	</section>

	@if (Model.Hub.CultureLinks.Count > 0)
	{
		<section class="sitemap-section" aria-labelledby="sitemap-languages">
			<div class="sitemap-section-head">
				<h2 id="sitemap-languages">Other Languages</h2>
			</div>
			<ul class="sitemap-pill-list">
				@foreach (SitemapCultureLink CultureLink in Model.Hub.CultureLinks)
				{
					<li>
						<a href="@CultureLink.Url" hreflang="@CultureLink.CultureCode" lang="@CultureLink.CultureCode" dir="auto">
							@CultureLink.DisplayName
						</a>
					</li>
				}
			</ul>
		</section>
	}

	@foreach (SitemapHubSection HubSection in Model.Hub.Sections)
	{
		<section class="sitemap-section" aria-labelledby="sitemap-section-@HubSection.Section.Slug">
			<div class="sitemap-section-head">
				<div>
					<h2 id="sitemap-section-@HubSection.Section.Slug">
						<a href="/info:sitemap/@HubSection.Section.Slug">@HubSection.Section.Title</a>
					</h2>
					<p class="sitemap-section-desc">@HubSection.Section.Description</p>
				</div>
				<span class="sitemap-count">@HubSection.TotalCount.ToString("N0")</span>
			</div>

			@if (HubSection.TotalCount > 0)
			{
				<nav class="sitemap-buckets" aria-label="@HubSection.Section.Title alphabetical index">
					<a class="sitemap-bucket sitemap-bucket-all" href="/info:sitemap/@HubSection.Section.Slug">All</a>
					@foreach (SitemapBucketLink Bucket in HubSection.Buckets)
					{
						if (Bucket.HasEntries)
						{
							<a class="sitemap-bucket" href="/info:sitemap/@HubSection.Section.Slug/@Bucket.Slug">@Bucket.Label</a>
						}
						else
						{
							<span class="sitemap-bucket is-empty" aria-disabled="true">@Bucket.Label</span>
						}
					}
				</nav>
			}
			else
			{
				<p class="sitemap-empty">No entries published in this section yet.</p>
			}
		</section>
	}
</div>
