@page "/wiki:header-helper"
@model WikiWikiWorld.Web.Pages.Wiki.HeaderHelperModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@{
	ViewData["Title"] = L["Header helper"];
	// Translations for header-helper.js (and messages its worker reports), keyed by the English text. English pages send
	// an empty map: the script falls back to the English it already has.
	Microsoft.Extensions.Localization.LocalizedString[] ScriptStrings =
	[
		L["Some websites block direct image imports. Download the picture, then choose Open image or drag it here. The picture stays in your browser until you choose to upload the finished header."],
		L["The image processor could not start. Reload the page and try again."],
		L["Enter an HTTP or HTTPS image URL."],
		L["Choose an image smaller than 50 MiB."],
		L["Opening cancelled or timed out. Try a local file."],
		L["Opening picture…"],
		L["Picture ready. Adjust the crop and check the previews."],
		L["Picture was not replaced."],
		L["Enter the article slug before downloading the header or copying markup."],
		L["{0} × {1} px · Native resolution, no upscaling."],
		L["Width below 1,500 px may look soft on wide screens."],
		L["Portrait crop: check desktop framing."],
		L["Article title"],
		L["Making your header on your device… Large pictures can take a while."],
		L["Processing cancelled."],
		L["Header ready · {0}."],
		L["This header exceeds the wiki’s 10 MiB upload limit. Lower the quality or choose a smaller crop, then download it again."],
		L["No new header was created."],
		L["Wiki markup copied."],
		L["Copy the selected markup with Ctrl+C / ⌘C."],
		L["This editor requires a current browser with WebAssembly and OffscreenCanvas. Try an up-to-date Chrome, Edge, Firefox, or Safari."],
		L["Open, drop, or paste a picture to begin. Pictures stay on your device."],
		L["This picture is too large for the browser editor. Reduce it to at most 40 megapixels and 16,384 pixels per side, then try again."],
		L["This HEIC/HEIF picture could not be decoded. Try saving it as PNG or JPEG."],
		L["HEIC decoding failed."],
		L["AVIF encoding failed. Try a smaller crop."],
		L["Could not process this picture. Try a smaller PNG or JPEG."]
	];
	bool IsEnglishPage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName is "en" or "iv";
	string ScriptText = System.Text.Json.JsonSerializer.Serialize(IsEnglishPage ? [] : ScriptStrings.ToDictionary(Text => Text.Name, Text => Text.Value));
}
@* Computed keys below; l10n: "Crop.X", "Crop.Y", "Crop.Width", "Crop.Height", "Device.Phone", "Device.Tablet", "Device.Desktop" *@
<h1>@L["Header helper"]</h1>
<p>@L["Frame a picture for {0}. Check how it looks on different screens, then download your header.", Model.SiteName]</p>
<noscript><p>@L["This editor needs JavaScript to process pictures on your device. Enable JavaScript to use it."]</p></noscript>
<div id="HeaderHelper" class="header-helper" data-ignore="true" data-site-name="@Model.SiteName" data-ui-text="@ScriptText" data-worker-url="@FileVersions.AddFileVersionToPath(HttpContext.Request.PathBase, "/js/header-helper-worker.js")">
	<div class="helper-status">
		<p id="HelperStatus" role="status">@L["Loading editor…"]</p>
		<button id="CancelOperation" type="button" data-button-variant="ghost" hidden>@L["Cancel"]</button>
	</div>
	<div id="HelperError" role="alert" hidden></div>
	<fieldset id="ImportControls" disabled>
		<legend><span class="step">1</span> @L["Open a picture"]</legend>
		<div class="helper-drop">
			<label for="SourceFile">@L["Open image"]</label>
			<input id="SourceFile" type="file" accept="image/jpeg,image/png,image/webp,image/avif,image/heic,image/heif,image/gif,image/bmp,.heic,.heif" />
			<p>@L["Or drop a picture here, or paste a copied picture with Ctrl+V / ⌘V. Up to 50 MiB; large images may exceed your device’s memory."]</p>
		</div>
		<label for="SourceUrl">@L["Or open an image URL"]</label>
		<div class="helper-row"><input id="SourceUrl" type="url" placeholder="https://…" aria-describedby="ImportHelp" /><button id="FetchImage" type="button" data-button-variant="ghost">@L["Open link"]</button></div>
		<p id="ImportHelp">@L["Some websites block direct image imports. If your link doesn’t work, download the picture, then choose Open image or drag it here. Your picture is processed in your browser; it won’t be uploaded to the wiki until you choose to upload the finished header."]</p>
	</fieldset>
	<fieldset id="EditControls" disabled>
		<legend><span class="step">2</span> @L["Frame your header"]</legend>
		<div class="helper-workspace">
			<div class="helper-editor">
				<div class="helper-toolbar">
					<p id="SourceInfo">@L["No picture selected."]</p>
					<div class="helper-row">
						<button id="ResetCrop" type="button" data-button-variant="ghost">@L["Reset crop"]</button>
						<button id="FitImage" type="button" data-button-variant="ghost">@L["Fit"]</button>
						<label for="Zoom">@L["Zoom"]</label><input id="Zoom" type="range" min="1" max="4" step="0.25" value="1" />
						<label><input id="AspectLock" type="checkbox" /> @L["Lock aspect"]</label>
					</div>
				</div>
				<div class="helper-viewport" id="EditorViewport" hidden>
					<div id="EditorSurface" class="helper-surface">
						<canvas id="SourceCanvas" aria-label="@L["Source picture"]"></canvas>
						<div id="CropBox" class="helper-crop" tabindex="0" role="group" aria-label="@L["Move crop with arrow keys; hold Shift for 10 pixels"]" aria-describedby="CropHelp">
							@foreach (string Corner in new[] { "NW", "NE", "SW", "SE" })
							{
								<button type="button" class="helper-handle" data-corner="@Corner" aria-label="@L["Resize {0} corner with arrow keys", Corner]"></button>
							}
						</div>
					</div>
				</div>
				<p id="CropHelp">@L["Drag the frame or its corners. Use arrow keys to move or resize; hold Shift for 10 pixels. Double-click the frame to reset. Zoom in and scroll for detail."]</p>
				<div class="helper-numbers">
					@foreach (string Coordinate in new[] { "X", "Y", "Width", "Height" })
					{
						<label>@L[$"Crop.{Coordinate}"] <small>px</small><input id="@($"Crop{Coordinate}")" type="number" min="@(Coordinate is "X" or "Y" ? 0 : 1)" step="1" value="0" /></label>
					}
				</div>
				<div class="helper-field">
					<label for="SiteFocus">@L["Site focus"]</label>
					<select id="SiteFocus" aria-describedby="SiteFocusHelp"><option value="top">@L["Top"]</option><option value="center">@L["Center"]</option><option value="bottom">@L["Bottom"]</option></select>
					<p id="SiteFocusHelp">@L["Focus changes the way the wiki positions your header, not the downloaded pixels."]</p>
				</div>
			</div>
			<section class="helper-preview-panel" aria-labelledby="PreviewHeading">
				<h2 id="PreviewHeading">@L["Device previews"]</h2>
				<div class="helper-previews">
					@foreach (string Device in new[] { "Phone", "Tablet", "Desktop" })
					{
						<figure><canvas id="@($"Preview{Device}")" aria-label="@L["{0} header preview", L[$"Device.{Device}"]]"></canvas><figcaption>@L[$"Device.{Device}"]</figcaption></figure>
					}
				</div>
				<div class="helper-toggles">
					<label><input id="ShowFade" type="checkbox" checked /> @L["Fade"]</label>
					<label><input id="ShowBar" type="checkbox" checked /> @L["Top bar"]</label>
					<label><input id="ShowTitle" type="checkbox" checked /> @L["Title"]</label>
					<label><input id="RestScale" type="checkbox" checked /> @L["Resting scale"]</label>
					<label><input id="DarkPreview" type="checkbox" /> @L["Dark preview"]</label>
				</div>
				<p>@L["Framing previews use the wiki’s header geometry. Titles and top bars are illustrative; paper texture and scrolling animation are not shown."]</p>
			</section>
		</div>
	</fieldset>
	<fieldset id="ExportControls" disabled>
		<legend><span class="step">3</span> @L["Download and use"]</legend>
		<div class="helper-export">
			<div class="helper-field">
				<label for="ArticleSlug">@L["Article slug"] <small>@L["(required)"]</small></label>
				<input id="ArticleSlug" type="text" placeholder="@L["your-article"]" maxlength="150" required aria-describedby="ArticleSlugHelp ArticleSlugError" />
				<div id="ArticleSlugError" role="alert" hidden></div>
				<p id="ArticleSlugHelp">@L["The URL of the article this is the header for, e.g. spider-man or gq-style-usa-summer-2023."]</p>
			</div>
			<div class="helper-field">
				<label for="Quality">@L["AVIF quality"]</label>
				<div class="helper-row"><input id="Quality" type="range" min="1" max="100" value="65" /><output id="QualityValue" for="Quality">65</output></div>
				<div id="OutputInfo"></div>
			</div>
		</div>
		<div class="helper-row helper-actions"><button id="ExportImage" type="button" data-button-variant="primary">@L["Download header"]</button><a id="DownloadImage" hidden>@L["Download didn’t start? Save header"]</a></div>
		<div class="helper-field">
			<label for="WikiText">@L["Wiki markup"]</label>
			<div class="helper-markup"><textarea id="WikiText" readonly rows="2"></textarea><button id="CopyMarkup" type="button" data-button-variant="ghost">@L["Copy markup"]</button></div>
			<p>@HL["Download the finished header, upload it as a {0}, then paste this markup into your article. The markup expects the file article’s URL slug to match the downloaded filename without “.avif”; if you give the file article a different slug, use that in the markup instead. Nothing is published automatically.", UiFormat.Link("/create:", L["file article"])]</p>
		</div>
	</fieldset>
</div>
@section Scripts {
	<script type="module" src="~/js/header-helper.js" asp-append-version="true"></script>
}
