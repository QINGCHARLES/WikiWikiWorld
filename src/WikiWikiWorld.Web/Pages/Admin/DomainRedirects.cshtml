@page
@using WikiWikiWorld.Web.Configuration
@using WikiWikiWorld.Web.Helpers
@using WikiWikiWorld.Web.Services
@model WikiWikiWorld.Web.Pages.Admin.DomainRedirectsModel
@{
	ViewData["Title"] = "Domain Redirects";
}

<figure>
	<h1>Domain Redirects</h1>
</figure>

<article>
	<p>
		Map legacy or alternate domains to specific articles. Requests to these domains receive an
		<strong>HTTP 308 Permanent Redirect</strong> to the target article on that culture.
		Because mappings link to the canonical article identifier, <strong>redirects survive article renames and slug changes</strong>.
	</p>

	@if (!string.IsNullOrEmpty(Model.SuccessMessage))
	{
		<div class="alert alert-success" role="alert">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
				<polyline points="22 4 12 14.01 9 11.01"></polyline>
			</svg>
			<span>@Model.SuccessMessage</span>
		</div>
	}

	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="alert alert-error" role="alert">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
			<span>@Model.ErrorMessage</span>
		</div>
	}

	<section class="card" style="margin-block: 2rem; padding: 1.5rem; border: 1px solid var(--md-outline-variant, #ccc); border-radius: 8px;">
		<h2>Add Domain Redirect</h2>
		<form method="post" asp-page-handler="Create" id="create-redirect-form">
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
				<div>
					<div class="md3-field md3-filled">
						<input asp-for="InputDomain" id="InputDomain" placeholder=" " required />
						<label asp-for="InputDomain">Incoming Domain (e.g. oldmag.com)</label>
						<span class="md-line"></span>
					</div>
					<span class="form-help">Enter bare domain or host without http://</span>
				</div>

				<div>
					<div class="md3-field md3-filled">
						<select asp-for="InputSiteId" id="InputSiteId">
							@foreach (SiteInfo Site in Model.Sites)
							{
								<option value="@Site.SiteId">@Site.SiteName (ID: @Site.SiteId)</option>
							}
						</select>
						<label asp-for="InputSiteId">Target Site</label>
						<span class="md-line"></span>
					</div>
				</div>

				<div>
					<div class="md3-field md3-filled">
						<select asp-for="InputCulture" id="InputCulture">
							@if (Model.Sites.Count > 0)
							{
								SiteInfo InitialSite = Model.Sites.FirstOrDefault(Site => Site.SiteId == Model.InputSiteId) ?? Model.Sites[0];
								List<string> InitialCultures = DomainRedirectsModel.GetCulturesForSite(InitialSite);
								foreach (string CultureCode in InitialCultures)
								{
									<option value="@CultureCode" selected="@(CultureCode == Model.InputCulture ? "selected" : null)">@CultureCode</option>
								}
							}
							else
							{
								<option value="en">en</option>
							}
						</select>
						<label asp-for="InputCulture">Target Culture</label>
						<span class="md-line"></span>
					</div>
				</div>
			</div>

			<div style="margin-bottom: 1.5rem;">
				<label style="display: block; font-weight: bold; margin-bottom: 0.5rem;">Target Article</label>
				
				<input type="hidden" asp-for="InputCanonicalArticleId" id="InputCanonicalArticleId" />
				<input type="hidden" asp-for="SelectedArticleTitle" id="SelectedArticleTitle" />

				<div id="selected-article-display" style="display: @(Model.InputCanonicalArticleId != Guid.Empty ? "flex" : "none"); align-items: center; gap: 1rem; padding: 0.75rem 1rem; background: var(--md-surface-variant, #f0f0f0); border-radius: 6px; margin-bottom: 0.75rem;">
					<div>
						<strong>Selected:</strong> <span id="selected-article-text">@Model.SelectedArticleTitle</span>
						<br /><small style="color: var(--md-on-surface-variant, #666);"><code id="selected-article-guid">@Model.InputCanonicalArticleId</code></small>
					</div>
					<button type="button" class="button" id="clear-article-btn" style="margin-left: auto; font-size: 0.85rem;" data-button-variant="naked">Change</button>
				</div>

				<div id="article-search-container" style="display: @(Model.InputCanonicalArticleId != Guid.Empty ? "none" : "block");">
					<div class="md3-field md3-filled" style="margin-bottom: 0.5rem;">
						<input type="text" id="article-search-input" placeholder=" " autocomplete="off" />
						<label for="article-search-input">Search for target article by title or slug...</label>
						<span class="md-line"></span>
					</div>
					<p id="article-picker-status" role="status"></p>
					<button type="button" id="retry-cultures" class="button" style="display: none;">Retry loading cultures</button>
					<div id="search-spinner" style="display: none; font-size: 0.85rem; color: var(--md-primary, #0066cc);">Searching...</div>
					<div id="article-results-list" style="max-height: 220px; overflow-y: auto; border: 1px solid var(--md-outline-variant, #ddd); border-radius: 6px; display: none;"></div>
				</div>
			</div>

			<button type="submit" class="button" id="submit-btn">Add Domain Redirect</button>
		</form>
	</section>

	<h2>Configured Domain Redirects (@Model.Redirects.Count)</h2>

	@if (Model.Redirects.Count == 0)
	{
		<div class="alert alert-info">No domain redirects configured yet.</div>
	}
	else
	{
		<table class="table" style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
			<thead>
				<tr>
					<th>Domain</th>
					<th>Site</th>
					<th>Culture</th>
					<th>Target Article</th>
					<th>Created</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (ArticleDomainRedirectAdminDto Item in Model.Redirects)
				{
					<tr>
						<td><code>@Item.Domain</code></td>
						<td>@Item.SiteName</td>
						<td><span class="badge">@Item.Culture</span></td>
						<td>
							@if (!string.IsNullOrEmpty(Item.ArticleUrlSlug))
							{
								string Path = ArticleUrlHelper.BuildArticlePath(Item.ArticleUrlSlug, Item.ArticleType);
								<a href="@Path" target="_blank" rel="noopener">@Item.ArticleTitle</a>
								<br /><small style="color: var(--md-on-surface-variant, #666);"><code>@Path</code></small>
							}
							else
							{
								<span>@Item.ArticleTitle</span>
							}
						</td>
						<td><small>@Item.DateCreated.ToString("yyyy-MM-dd HH:mm") UTC</small></td>
						<td>
							<form method="post" asp-page-handler="Delete" asp-route-id="@Item.Id" onsubmit="return confirm('Are you sure you want to delete the redirect for @Item.Domain?');">
								<button type="submit" class="button" style="color: var(--md-error, #b00020); font-size: 0.85rem;" data-button-variant="naked">Delete</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
</article>

<script>
	document.addEventListener("DOMContentLoaded", function ()
	{
		const SiteSelect = document.getElementById("InputSiteId");
		const CultureSelect = document.getElementById("InputCulture");
		const SearchInput = document.getElementById("article-search-input");
		const ResultsList = document.getElementById("article-results-list");
		const Spinner = document.getElementById("search-spinner");
		const CanonicalIdInput = document.getElementById("InputCanonicalArticleId");
		const ArticleTitleInput = document.getElementById("SelectedArticleTitle");
		const SelectedDisplay = document.getElementById("selected-article-display");
		const SelectedText = document.getElementById("selected-article-text");
		const SelectedGuid = document.getElementById("selected-article-guid");
		const SearchContainer = document.getElementById("article-search-container");
		const ClearButton = document.getElementById("clear-article-btn");
		const Status = document.getElementById("article-picker-status");
		const RetryCultures = document.getElementById("retry-cultures");
		if (!SiteSelect || !CultureSelect || !SearchInput) return;
		let CultureRequest = null;
		let SearchRequest = null;
		let DebounceTimer = 0;
		let CulturesReady = Boolean(SiteSelect.value && CultureSelect.value);
		SearchInput.disabled = !CulturesReady;

		/** Invalidate the search immediately, including a response body already queued for this context. */
		function CancelSearch()
		{
			clearTimeout(DebounceTimer);
			SearchRequest?.Controller.abort();
			SearchRequest = null;
			Spinner.style.display = "none";
			ResultsList.replaceChildren();
			ResultsList.style.display = "none";
		}

		/** Remove a target as soon as its site/culture is changed, before any dependent request completes. */
		function ClearSelection()
		{
			CancelSearch();
			CanonicalIdInput.value = "";
			ArticleTitleInput.value = "";
			SelectedText.textContent = "";
			SelectedGuid.textContent = "";
			SelectedDisplay.style.display = "none";
			SearchContainer.style.display = "block";
			SearchInput.value = "";
		}

		/** Load only the selected site's cultures, keeping dependent search unavailable until they are ready. */
		async function LoadCultures()
		{
			CultureRequest?.Controller.abort();
			const Request = { SiteId: SiteSelect.value, Controller: new AbortController() };
			CultureRequest = Request;
			CulturesReady = false;
			ClearSelection();
			CultureSelect.replaceChildren();
			CultureSelect.disabled = true;
			SearchInput.disabled = true;
			RetryCultures.style.display = "none";
			Status.textContent = "Loading cultures…";
			try
			{
				const Response = await fetch(`?handler=Cultures&siteid=${encodeURIComponent(Request.SiteId)}`, { signal: Request.Controller.signal });
				if (!Response.ok) throw new Error("Culture lookup failed.");
				const Cultures = await Response.json();
				if (CultureRequest !== Request || SiteSelect.value !== Request.SiteId) return;
				if (!Array.isArray(Cultures) || Cultures.length === 0) throw new Error("No cultures were returned.");
				for (const Culture of Cultures)
				{
					const Option = document.createElement("option");
					Option.value = Culture;
					Option.textContent = Culture;
					CultureSelect.appendChild(Option);
				}
				CulturesReady = true;
				CultureSelect.disabled = false;
				SearchInput.disabled = false;
				CultureRequest = null;
				Status.textContent = "";
			}
			catch (Failure)
			{
				if (CultureRequest !== Request || SiteSelect.value !== Request.SiteId) return;
				CultureRequest = null;
				Status.textContent = "Could not load cultures for this site. Retry loading cultures or choose another site.";
				RetryCultures.style.display = "inline-flex";
			}
		}

		/** Check ownership as well as input values; returning to an earlier query must not revive its old request. */
		function IsCurrentSearch(Request)
		{
			return SearchRequest === Request && CulturesReady && SiteSelect.value === Request.SiteId &&
				CultureSelect.value === Request.Culture && SearchInput.value.trim() === Request.Query;
		}

		/** Commit a target to the existing native form, cancelling any work that could reopen its search view. */
		function SelectArticle(Item)
		{
			CancelSearch();
			CanonicalIdInput.value = Item.CanonicalArticleId;
			ArticleTitleInput.value = Item.Title;
			SelectedText.textContent = `${Item.Title} (/${Item.UrlSlug})`;
			SelectedGuid.textContent = Item.CanonicalArticleId;
			SearchInput.value = "";
			SearchContainer.style.display = "none";
			SelectedDisplay.style.display = "flex";
			Status.textContent = "";
		}

		SiteSelect.addEventListener("change", LoadCultures);
		RetryCultures.addEventListener("click", LoadCultures);
		CultureSelect.addEventListener("change", () => { ClearSelection(); Status.textContent = ""; });
		ClearButton.addEventListener("click", () => { ClearSelection(); Status.textContent = ""; SearchInput.focus(); });
		SearchInput.addEventListener("input", () =>
		{
			CancelSearch();
			if (!CulturesReady) return;
			Status.textContent = "";
			const Query = SearchInput.value.trim();
			if (Query.length < 2) return;
			const Request = { SiteId: SiteSelect.value, Culture: CultureSelect.value, Query, Controller: new AbortController() };
			SearchRequest = Request;
			Spinner.style.display = "block";
			DebounceTimer = setTimeout(async () =>
			{
				try
				{
					const Parameters = new URLSearchParams({ handler: "SearchArticles", siteid: Request.SiteId, culture: Request.Culture, q: Request.Query });
					const Response = await fetch(`?${Parameters}`, { signal: Request.Controller.signal });
					if (!Response.ok) throw new Error("Article lookup failed.");
					const Items = await Response.json();
					if (!IsCurrentSearch(Request)) return;
					ResultsList.replaceChildren();
					if (Items.length === 0)
					{
						ResultsList.textContent = "No matching articles found.";
					}
					for (const Item of Items)
					{
						const Row = document.createElement("button");
						Row.type = "button";
						Object.assign(Row.style, { display: "block", padding: "0.6rem 1rem", cursor: "pointer", width: "100%", textAlign: "start", background: "transparent", color: "inherit", font: "inherit", letterSpacing: "normal", border: "0", borderRadius: "0", borderBottom: "1px solid var(--md-outline-variant, #eee)" });
						const Title = document.createElement("strong");
						Title.textContent = Item.Title;
						const Slug = document.createElement("small");
						Slug.style.color = "#666";
						Slug.textContent = ` (/${Item.UrlSlug})`;
						Row.append(Title, Slug);
						Row.addEventListener("mouseover", () => { Row.style.background = "var(--md-surface-variant, #f5f5f5)"; });
						Row.addEventListener("mouseout", () => { Row.style.background = "transparent"; });
						Row.addEventListener("click", () => SelectArticle(Item));
						ResultsList.appendChild(Row);
					}
					ResultsList.style.display = "block";
				}
				catch (Failure)
				{
					if (IsCurrentSearch(Request)) Status.textContent = "Could not load articles. Type your search again to retry.";
				}
				finally
				{
					if (IsCurrentSearch(Request))
					{
						Spinner.style.display = "none";
						SearchRequest = null;
					}
				}
			}, 300);
		});
	});
</script>
