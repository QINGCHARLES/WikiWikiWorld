@page
@model WikiWikiWorld.Web.Pages.Admin.TrustedDomainsModel
@{
	ViewData["Title"] = L["Trusted domains"];
}
@functions {
	/// <summary>Renders a UTC instant as a machine-readable time element with a short local date.</summary>
	/// <param name="Instant">The instant to show.</param>
	/// <returns>The time element.</returns>
	private static Microsoft.AspNetCore.Html.IHtmlContent When(DateTimeOffset Instant) =>
		new Microsoft.AspNetCore.Html.HtmlString(
			$"<time datetime=\"{Instant.UtcDateTime.ToString("O", CultureInfo.InvariantCulture)}\">{System.Net.WebUtility.HtmlEncode(Instant.UtcDateTime.ToString("d", CultureInfo.CurrentCulture))}</time>");

	/// <summary>Renders a username as a link to its profile, or a dash when there is none (seeded rows, deleted accounts).</summary>
	/// <param name="UserName">The username, if known.</param>
	/// <returns>The link or dash.</returns>
	private static Microsoft.AspNetCore.Html.IHtmlContent Person(string? UserName) => UserName is null
		? new Microsoft.AspNetCore.Html.HtmlString("—")
		: new Microsoft.AspNetCore.Html.HtmlString(
			$"<a href=\"/@{Uri.EscapeDataString(UserName)}/profile\">{System.Net.WebUtility.HtmlEncode(UserName)}</a>");
}

<header class="admin-heading">
	<h1>@L["Trusted domains"]</h1>
	<p>@L["Review link-domain proposals and update trusted domains."]</p>
</header>

<div class="admin-stack">
	@if (!string.IsNullOrEmpty(Model.SuccessMessage))
	{
		<div class="admin-notice" role="status">@Model.SuccessMessage</div>
	}

	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="admin-notice" role="alert">@Model.ErrorMessage</div>
	}

	<details class="admin-guidance">
		<summary>@L["Review guidelines"]</summary>
		<p>@L["Confirming a domain makes every link to it, and to its subdomains, followed by search engines on every page, straight away."]</p>
		<p>@L["Trust official sites: magazines and publishers, libraries, archives, museums and government. Deny hosts where anyone can publish (blogs, Medium, Substack, social networks), because trust covers every subdomain."] <a href="/wiki:trusted-domains">@L["Members' page"]</a></p>
	</details>

	<section class="admin-panel" aria-labelledby="pending-domains-title">
		<div class="admin-review-toolbar">
			<h2 id="pending-domains-title">@L["Waiting for review ({0})", Model.PendingCount]</h2>
			@if (Model.Pending.Count > 0)
			{
				<form id="confirm-selected-domains" method="post" asp-page-handler="ConfirmSelected" asp-route-pagenumber="@Model.PageNumber">
					<button type="submit" class="button" data-button-variant="primary">@L["Confirm selected"]</button>
				</form>
			}
		</div>
		@if (Model.Pending.Count == 0)
		{
			<p class="admin-empty">@L["No proposals are waiting."]</p>
		}
		else
		{
			<ul class="admin-proposal-list" role="list">
				@foreach (TrustedLinkDomainView Proposal in Model.Pending)
				{
					string NoteId = $"note-{Proposal.Id}";
					<li class="admin-proposal">
						<label class="admin-proposal-select">
							<input type="checkbox" name="selectedids" value="@Proposal.Id" form="confirm-selected-domains" />
							<span class="admin-visually-hidden">@L["Select {0}", Proposal.Domain]</span>
						</label>
						<div>
							<h3><a href="https://@Proposal.Domain/" target="_blank" rel="nofollow noopener noreferrer"><bdi>@Proposal.Domain</bdi></a></h3>
							<p class="admin-proposal-reason">@Proposal.ProposalNote</p>
							<small class="admin-proposal-meta">
								<span>@L["Proposed by"] @Person(Proposal.ProposedBy)</span>
								@When(Proposal.DateProposed)
							</small>
						</div>
						<details class="admin-proposal-review">
							<summary class="button" aria-label="@L["Review with note for {0}", Proposal.Domain]">@L["Review with note"]</summary>
							<form method="post" asp-page-handler="Confirm" asp-route-pagenumber="@Model.PageNumber">
								<input type="hidden" name="Id" value="@Proposal.Id" />
								<label for="@NoteId">@L["Note to the proposer (optional)"]</label>
								<textarea id="@NoteId" name="Note" rows="3" maxlength="@TrustedLinkDomainService.MaxNoteLength"></textarea>
								<div class="admin-actions">
									<button type="submit" class="button" data-button-variant="primary">@L["Confirm"]</button>
									<button type="submit" class="button" data-button-variant="negative-quiet" asp-page-handler="Deny"
										asp-route-pagenumber="@Model.PageNumber">@L["Deny"]</button>
								</div>
							</form>
						</details>
					</li>
				}
			</ul>
		}

		@if (Model.PageCount > 1)
		{
			<nav class="admin-pagination" aria-label="@L["Pending proposal pages"]">
				@if (Model.PageNumber > 1)
				{
					<a class="button" asp-page="/Admin/TrustedDomains" asp-route-pagenumber="@(Model.PageNumber - 1)">@L["Previous"]</a>
				}
				<span>@L["Page {0} of {1}", Model.PageNumber, Model.PageCount]</span>
				@if (Model.PageNumber < Model.PageCount)
				{
					<a class="button" asp-page="/Admin/TrustedDomains" asp-route-pagenumber="@(Model.PageNumber + 1)">@L["Next"]</a>
				}
			</nav>
		}
	</section>

	<section class="admin-panel">
		<h2 id="admin-trusted-title">@L["Trusted ({0})", Model.Trusted.Count]</h2>
		@if (Model.Trusted.Count == 0)
		{
			<p class="admin-empty">@L["No domains are trusted yet."]</p>
		}
		else
		{
			<div class="admin-table" role="region" aria-labelledby="admin-trusted-title" tabindex="0">
				<table>
					<thead>
						<tr>
							<th scope="col">@L["Domain"]</th>
							<th scope="col">@L["Reason"]</th>
							<th scope="col">@L["Proposed by"]</th>
							<th scope="col">@L["Confirmed by"]</th>
							<th scope="col">@L["Withdraw"]</th>
						</tr>
					</thead>
					<tbody>
						@foreach (TrustedLinkDomainView Domain in Model.Trusted)
						{
							string RevokeNoteId = $"revoke-note-{Domain.Id}";
							<tr>
								<td><code>@Domain.Domain</code></td>
								<td class="note">@Domain.ProposalNote</td>
								<td>@Person(Domain.ProposedBy)</td>
								<td>
									@Person(Domain.ReviewedBy)
									@if (Domain.DateReviewed is DateTimeOffset Reviewed)
									{
										<br />@When(Reviewed)
									}
								</td>
								<td>
									<form class="admin-revoke-form" method="post" asp-page-handler="Revoke"
										data-confirm="@L["Stop trusting {0}? Its links will be nofollow again on every page.", Domain.Domain]"
										onsubmit="return confirm(this.dataset.confirm);">
										<input type="hidden" name="Id" value="@Domain.Id" />
										<label class="admin-visually-hidden" for="@RevokeNoteId">@L["Reason for withdrawing {0} (optional)", Domain.Domain]</label>
										<input type="text" id="@RevokeNoteId" name="Note" maxlength="@TrustedLinkDomainService.MaxNoteLength" placeholder="@L["Reason (optional)"]" />
										<button type="submit" class="button" data-button-variant="negative-quiet">@L["Withdraw trust"]</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>

	@if (Model.History.Count > 0)
	{
		<section class="admin-panel">
			<h2 id="admin-domain-history-title">@L["Recent decisions"]</h2>
			<div class="admin-table" role="region" aria-labelledby="admin-domain-history-title" tabindex="0">
				<table>
					<thead>
						<tr>
							<th scope="col">@L["Domain"]</th>
							<th scope="col">@L["Status"]</th>
							<th scope="col">@L["Proposed by"]</th>
							<th scope="col">@L["Decided by"]</th>
							<th scope="col">@L["Note"]</th>
						</tr>
					</thead>
					<tbody>
						@foreach (TrustedLinkDomainView Entry in Model.History)
						{
							bool Revoked = Entry.Status == TrustedLinkDomainStatus.Revoked;
							DateTimeOffset? Decided = Revoked ? Entry.DateRevoked : Entry.DateReviewed;
							<tr>
								<td><code>@Entry.Domain</code></td>
								<td>@TrustedLinkDomainService.StatusLabel(Entry.Status)</td>
								<td>@Person(Entry.ProposedBy)</td>
								<td>
									@Person(Revoked ? Entry.RevokedBy : Entry.ReviewedBy)
									@if (Decided is DateTimeOffset At)
									{
										<br />@When(At)
									}
								</td>
								<td class="note">@(Revoked ? Entry.RevocationNote : Entry.ReviewNote)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
</div>
