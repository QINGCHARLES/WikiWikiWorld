@page
@model WikiWikiWorld.Web.Pages.Account.RegisterModel
@{
	ViewData["Title"] = "Create an Account";
}

<section class="auth" aria-labelledby="AuthTitle">
	<header class="auth-header">
		<p class="auth-eyebrow">Join the archive</p>
		<h1 id="AuthTitle">Sign Up</h1>
		<p class="auth-lede">Create an account to edit articles, upload covers and join the discussion.</p>
	</header>

	<form class="auth-card" method="post">
		<div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

		<div class="auth-field">
			<div class="md3-field md3-filled">
				<input asp-for="Input.UserName" placeholder=" " autocomplete="username" autocapitalize="none" spellcheck="false" />
				<label asp-for="Input.UserName"></label>
				<span class="md-line"></span>
			</div>
			<span asp-validation-for="Input.UserName"></span>
		</div>

		<div class="auth-field">
			<div class="md3-field md3-filled">
				<input asp-for="Input.Email" placeholder=" " autocomplete="email" autocapitalize="none" spellcheck="false" />
				<label asp-for="Input.Email"></label>
				<span class="md-line"></span>
			</div>
			<span asp-validation-for="Input.Email"></span>
		</div>

		<div class="auth-field">
			<div class="md3-field md3-filled">
				<input asp-for="Input.Password" placeholder=" " autocomplete="new-password" minlength="8" maxlength="100" aria-describedby="PasswordHint" />
				<label asp-for="Input.Password"></label>
				<span class="md-line"></span>
			</div>
			<p id="PasswordHint" class="auth-hint">Use 8–100 characters, including uppercase and lowercase letters, a number and a symbol.</p>
			<span asp-validation-for="Input.Password"></span>
		</div>

		<div class="auth-field">
			<div class="md3-field md3-filled">
				<input asp-for="Input.ConfirmPassword" placeholder=" " autocomplete="new-password" />
				<label asp-for="Input.ConfirmPassword"></label>
				<span class="md-line"></span>
			</div>
			<span asp-validation-for="Input.ConfirmPassword"></span>
		</div>

		<button type="submit" class="button auth-submit">Create Account</button>
	</form>

	<p class="auth-switch">
		Already have an account? <a asp-page="/Account/Login">Log in</a>
	</p>
</section>
