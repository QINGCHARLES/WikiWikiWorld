@page
@model ViewModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@{
	string IconSpriteUrl = FileVersions.AddFileVersionToPath(HttpContext.Request.PathBase, Url.Content("~/icons.svg"));
	ViewData["Title"] = !string.IsNullOrWhiteSpace(Model.PlainTextTitle) ? Model.PlainTextTitle : L["Article Not Found"];
}
@functions {
	static string FormatFileSize(long SizeBytes)
	{
		return SizeBytes switch
		{
			>= 1_048_576 => SharedResource.Format("{0} MB", (SizeBytes / 1_048_576.0).ToString("F1", CultureInfo.CurrentCulture)),
			>= 1_024 => SharedResource.Format("{0} KB", (SizeBytes / 1_024.0).ToString("F1", CultureInfo.CurrentCulture)),
			_ => SharedResource.Format("{0} bytes", SizeBytes)
		};
	}
}

<figure>
	@if(!string.IsNullOrWhiteSpace(Model.HeaderImage))
	{
		<img src="@Model.HeaderImage" alt="..." class="hero-image" data-focus="@Model.HeaderImageFocus" />
	}
</figure>
<hgroup>
	@if (!string.IsNullOrWhiteSpace(Model.EyebrowLabel))
	{
		<p class="eyebrow">@Model.EyebrowLabel</p>
	}
	<h1 class="display-title" style="@Model.DisplayTitleFitStyle" data-ignore="true">@Html.Raw(Model.DisplayTitleHtml)</h1>
	@if (!string.IsNullOrWhiteSpace(Model.SubtitleText))
	{
		<p class="subtitle">@Model.SubtitleText</p>
	}
</hgroup>

@if (!string.IsNullOrWhiteSpace(Model.RedirectedFromTitle))
{
	<div class="revision-notice redirect-notice" role="status">
		@HL["Redirected from {0}.", UiFormat.Strong(Model.RedirectedFromTitle)]
	</div>
}

@if (!Model.IsPriorRevision && Model.SaveWarnings.Count > 0)
{
	<div class="revision-notice save-warnings" role="status">
		<strong>@L["Saved, but the article needs attention."]</strong> @L["Only you see this message."]
		<ul>
			@foreach (string Warning in Model.SaveWarnings)
			{
				<li>@Warning</li>
			}
		</ul>
		<a href="@($"{Model.CurrentArticlePath}/edit")" rel="nofollow">@L["Edit the article"]</a>
	</div>
}

@if (Model.IsViewingCurrentRevision && Model.Revision is not null)
{
	<div class="revision-notice">
		<strong>@L["You are viewing the current revision of this article."]</strong><br>
		@L["To see the canonical URL, visit:"]
		<a href="@Model.CurrentArticlePath">@L["Go to Latest Version"]</a>
	</div>
}

@if (Model.IsPriorRevision && Model.DisplayedRevision is not null && Model.CurrentRevision is not null)
{
	<div class="revision-notice">
		<strong>@L["You're viewing a prior revision."]</strong><br>
		@HL["This revision was published on {0}.", UiFormat.Strong(UiFormat.Date(Model.DisplayedRevision.DateCreated, "dd MMMM yyyy HH:mm"))]<br>
		@HL["The current version was published on {0}.", UiFormat.Strong(UiFormat.Date(Model.CurrentRevision.DateCreated, "dd MMMM yyyy HH:mm"))]
		<a href="@Model.CurrentArticlePath">@L["View Current"]</a>

		@if (Model.HasTitleChanged)
		{
			<p>
				<strong>@L["Note:"]</strong> @HL["The title of this article has changed from \"{0}\" to \"{1}\".", UiFormat.Strong(Model.DisplayedRevision.Title), UiFormat.Strong(Model.CurrentRevision.Title)]
			</p>
		}

		@if (Model.HasUrlSlugChanged)
		{
			<p>
				<strong>@L["Note:"]</strong> @HL["The URL of this article has changed from \"{0}\" to \"{1}\".", UiFormat.Strong(Model.DisplayedCanonicalUrlSlug), UiFormat.Strong(Model.CurrentCanonicalUrlSlug)]<br>
				<a href="@Model.CurrentArticlePath">@L["Go to New URL"]</a>
			</p>
		}
	</div>
}
else if(Model.DisplayedRevision is not null)
{
	<div class="editor-info">
		@if (Model.RecentAuthors.Count > 0)
		{
			ArticleAuthor PrimaryAuthor = Model.RecentAuthors[0];
			<div class="editor-authors">
				<dl>
					<dt>@(Model.RecentAuthors.Count == 1 ? L["Created by"] : L["Improved by"])</dt>
					<dd>
						<a href="/@@@PrimaryAuthor.UserName">@PrimaryAuthor.UserName</a>@if (Model.RecentAuthors.Count > 1)
						{
							<span> @L["& others"]</span>
						}
					</dd>
				</dl>
				<address>
					@for (int i = 0; i < Model.RecentAuthors.Count; i++)
					{
						ArticleAuthor Author = Model.RecentAuthors[i];
						string? AvatarUrl = Author.ProfilePicGuid.HasValue
							? $"/sitefiles/{Model.SiteId}/profilepics/{Author.ProfilePicGuid.Value}.png"
							: null;
						string Initial = !string.IsNullOrEmpty(Author.UserName)
							? char.ToUpperInvariant(Author.UserName[0]).ToString()
							: "?";

						<a href="/@@@Author.UserName" class="avatar" title="@Author.UserName" style="z-index: @(Model.RecentAuthors.Count - i);">
							@if (!string.IsNullOrWhiteSpace(AvatarUrl))
							{
								<img src="@AvatarUrl" alt="@Author.UserName" />
							}
							else
							{
								<span>@Initial</span>
							}
						</a>
					}
				</address>
			</div>
		}
		@{
			string RelativeTimeText = WikiWikiWorld.Web.Helpers.TimeAgo.GetRelativeTime(DateTimeOffset.UtcNow, Model.DisplayedRevision.DateCreated);
			if (RelativeTimeText.Length > 0)
			{
				RelativeTimeText = char.ToUpperInvariant(RelativeTimeText[0]) + RelativeTimeText[1..];
			}
		}
		<dl>
			<dt>@L["Last Updated"]</dt>
			<dd><time datetime="@Model.DisplayedRevision.DateCreated.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@RelativeTimeText</time></dd>
		</dl>
	</div>
}

@if (Model.DisplayedRevision is not null)
{
	string? SourcePath = Model.RevisionSourcePath;
	<div class="article-actions" role="toolbar" aria-label="@L["Article actions"]">
		@if (Model.CurrentRevision is not null)
		{
			<partial name="_Bookmark" model="Model.BookmarkControl" />
			<a href="@Model.TalkPath" class="article-action-talk" rel="nofollow">
				<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
					<use href="@IconSpriteUrl#Discuss"></use>
				</svg>
				<span>@Model.TalkLabel</span>
			</a>
		}
		<div class="m3-split-button">
			<a href="@(SourcePath ?? $"{Model.CurrentArticlePath}/edit")" rel="nofollow">
				<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
					<use href="@($"{IconSpriteUrl}#{(SourcePath is null ? "Edit" : "Source")}")"></use>
				</svg>
				@if (SourcePath is not null)
				{
					<span>@L["View source"]</span>
				}
				else
				{
					<span>@L["Edit"]<span class="action-label-extra">@L["EditArticle.Suffix"]</span></span>
				}
			</a>
			@if (Model.CurrentRevision is not null)
			{
				<details name="site-menu" class="dropdown-menu">
					<summary aria-label="@L["More article actions"]">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<use href="@IconSpriteUrl#More"></use>
						</svg>
					</summary>
					<div class="menu-content">
						@if (!Model.IsPriorRevision && Model.DisplayedRevision.Type == WikiWikiWorld.Data.Models.ArticleType.File)
						{
							<a href="@($"{Model.DisplayedArticlePath}/edit#file-upload-section")" rel="nofollow">
								<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
									<use href="@IconSpriteUrl#Upload"></use>
								</svg>
								<span>@L["Upload new file version"]</span>
							</a>
						}
						<a href="@($"{Model.CurrentArticlePath}/history")" rel="nofollow">
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
								<use href="@IconSpriteUrl#History"></use>
							</svg>
							<span>@L["View history"]</span>
						</a>
						<a href="#">
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
								<use href="@IconSpriteUrl#Watch"></use>
							</svg>
							<span>@L["Watch article"]</span>
						</a>
						<a href="@($"{Model.CurrentArticlePath}/links")" rel="nofollow">
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
								<use href="@IconSpriteUrl#Links"></use>
							</svg>
							<span>@L["What links here"]</span>
						</a>
						<a href="@($"{Model.CurrentArticlePath}/languages")" rel="nofollow">
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
								<use href="@IconSpriteUrl#Languages"></use>
							</svg>
							<span>@L["Other languages"]</span>
						</a>
						<a href="#">
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
								<use href="@IconSpriteUrl#Report"></use>
							</svg>
							<span>@L["Report article"]</span>
						</a>
						@if (!Model.IsPriorRevision)
						{
							<hr />
							<a href="#" class="menu-item-danger">
								<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
									<use href="@IconSpriteUrl#Delete"></use>
								</svg>
								<span>@L["Delete article"]</span>
							</a>
						}
					</div>
				</details>
			}
		</div>
	</div>
}

@if (!Model.IsPriorRevision && Model.ShowPublicationUploadAside && Model.DisplayedRevision is not null)
{
	<aside class="publication-upload-cta">
		<p>
			@L["Have a copy of this publication you can legally share?"]
			<a href="/wiki:upload?ArticleSlug=@(Model.DisplayedRevision.UrlSlug)" rel="nofollow">
				@L["Submit it now"]
			</a>
		</p>
	</aside>
}

<article data-ignore="true">

	@section Scripts {
		<script src="~/js/article-view.js" asp-append-version="true"></script>
		@if (Model.BookmarkControl.IsSignedIn)
		{
			<script type="module" src="~/js/bookmark-notes.js" asp-append-version="true"></script>
		}
		@if (!string.IsNullOrWhiteSpace(Model.HeaderImage))
		{
			<script type="module" src="~/js/header-paper-texture.js" asp-append-version="true"></script>
			<script type="module" src="~/js/search-glass.js" asp-append-version="true"></script>
		}
	}

	@if (Model.DisplayedRevision is not null)
	{
		@if (!string.IsNullOrWhiteSpace(Model.FileImageUrl))
		{
			<section id="file-info-panel">
				<figure>
					<a href="@Model.FileImageUrl">
						<img src="@Model.FileImageUrl"
							 alt="@Model.PlainTextTitle"

							 loading="eager" />
					</a>
				</figure>
				<dl>
					<div>
						<dt>@L["Filename"]</dt>
						<dd>@Model.FileOriginalFilename</dd>
					</div>
					<div>
						<dt>@L["Type"]</dt>
						<dd>@Model.FileMimeType</dd>
					</div>
					@if (!string.IsNullOrWhiteSpace(Model.FileCodec))
					{
						<div>
							<dt>@L["Codec"]</dt>
							<dd>@Model.FileCodec</dd>
						</div>
					}
					@if (Model.FileWidthPx > 0 && Model.FileHeightPx > 0)
					{
						<div>
							<dt>@L["Dimensions"]</dt>
							<dd>@L["{0} × {1} px", Model.FileWidthPx, Model.FileHeightPx]</dd>
						</div>
					}
				<div>
					<dt>@L["Size"]</dt>
					<dd>@FormatFileSize(Model.FileSizeBytes)</dd>
				</div>
				@if (!string.IsNullOrWhiteSpace(Model.FileSourceText))
				{
					<div class="file-source">
						<dt>@L["Source"]</dt>
						<dd>
							@if (!string.IsNullOrWhiteSpace(Model.FileSourceUrl) && Model.FileSourceText == Model.FileSourceUrl)
							{
								<a href="@Model.FileSourceUrl"
								   rel="@(Model.IsFileSourceApprovedDomain ? "noopener" : "nofollow noopener")"
								   target="_blank">@Model.FileSourceUrl</a>
							}
							else
							{
								@Model.FileSourceText
								@if (!string.IsNullOrWhiteSpace(Model.FileSourceUrl))
								{
									<text>&ensp;</text><a href="@Model.FileSourceUrl"
									   rel="@(Model.IsFileSourceApprovedDomain ? "noopener" : "nofollow noopener")"
									   target="_blank">@Model.FileSourceUrl</a>
								}
							}
						</dd>
					</div>
				}
			</dl>
			<footer>
				<a href="@Model.FileImageUrl" target="_blank" rel="noopener" class="button" data-button-variant="ghost">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
					<span>@L["View Full Resolution"]</span>
				</a>
				@if (!Model.IsPriorRevision && User.Identity?.IsAuthenticated == true)
				{
					<a href="@($"{Model.DisplayedArticlePath}/edit#file-upload-section")" class="button" rel="nofollow">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
							<polyline points="17 8 12 3 7 8"></polyline>
							<line x1="12" y1="3" x2="12" y2="15"></line>
						</svg>
						<span>@L["Upload New Version"]</span>
					</a>
				}
			</footer>
			</section>

			@if (Model.FileRevisionHistory.Count > 0)
			{
				<section id="file-history-panel">
					<header>
						<div>
							<h2>@L["File History"]</h2>
							<p>
								@SharedResource.Plural("FileHistory.VersionsRecorded", Model.FileRevisionHistory.Count)
							</p>
						</div>
						@if (!Model.IsPriorRevision && User.Identity?.IsAuthenticated == true)
						{
							<a href="@($"{Model.DisplayedArticlePath}/edit#file-upload-section")" class="button" rel="nofollow">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
									<polyline points="17 8 12 3 7 8"></polyline>
									<line x1="12" y1="3" x2="12" y2="15"></line>
								</svg>
								<span>@L["Upload a new version of this file"]</span>
							</a>
						}
					</header>

					<div>
						@foreach (FileRevisionHistoryItem Rev in Model.FileRevisionHistory)
						{
							<article class="file-history-item @(Rev.IsCurrent ? "is-current" : "")">
								<a href="@Rev.FileImageUrl" target="_blank" rel="noopener" title="@L["View full resolution for revision {0}", Rev.Id]">
									<img src="@Rev.FileImageUrl"
										 alt="@L["{0} (Revision {1})", Model.PlainTextTitle ?? string.Empty, Rev.Id]"

										 loading="lazy" />
								</a>
								<div>
									<header>
										<span class="file-history-badge">
											@(Rev.IsCurrent ? L["Current version"] : L["Previous version"])
										</span>
										<time datetime="@Rev.DateCreated.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@UiFormat.Date(Rev.DateCreated, "dd MMMM yyyy, HH:mm")</time>
										@if (!string.IsNullOrWhiteSpace(Rev.CreatedByUserName))
										{
											<span class="file-history-author">
												@HL["by {0}", UiFormat.Link($"/@{Rev.CreatedByUserName}", Rev.CreatedByUserName)]
											</span>
										}
									</header>

									<dl>
										<div>
											<dt>@L["Dimensions"]</dt>
											<dd>
												@(Rev.ImageWidthPixels.HasValue && Rev.ImageHeightPixels.HasValue
													? L["{0} × {1} px", Rev.ImageWidthPixels.Value, Rev.ImageHeightPixels.Value].Value
													: L["Unknown"].Value)
											</dd>
										</div>
										<div>
											<dt>@L["Codec / Format"]</dt>
											<dd>@Rev.Codec (@Rev.MimeType)</dd>
										</div>
										<div>
											<dt>@L["File Size"]</dt>
											<dd>@FormatFileSize(Rev.FileSizeBytes)</dd>
										</div>
										<div>
											<dt>@L["Filename"]</dt>
											<dd>@Rev.Filename</dd>
										</div>
									</dl>

									@if (!string.IsNullOrWhiteSpace(Rev.RevisionReason))
									{
										<div class="file-history-comment">
											<strong>@L["Comment:"]</strong>
											@Rev.RevisionReason
										</div>
									}
								</div>
							</article>
						}
					</div>
				</section>
			}
		}

		@Html.Raw(Model.ArticleRevisionHtml)

		@if(Model.IsPriorRevision)
		{
			<p>
				<small>
					@L["Published on: {0}", Model.DisplayedRevision is null ? string.Empty : UiFormat.Date(Model.DisplayedRevision.DateCreated, "dd MMMM yyyy HH:mm")]
				</small>
			</p>
		}

	}
	else
	{
		<p>@L["Article not found."]</p>
	}
</article>
