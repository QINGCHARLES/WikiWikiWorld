@page
@model ViewModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@{
	string IconSpriteUrl = FileVersions.AddFileVersionToPath(HttpContext.Request.PathBase, Url.Content("~/icons.svg"));
	ViewData["Title"] = !string.IsNullOrWhiteSpace(Model.PlainTextTitle) ? Model.PlainTextTitle : "Article Not Found";
}
@functions {
	static string FormatFileSize(long SizeBytes)
	{
		return SizeBytes switch
		{
			>= 1_048_576 => $"{SizeBytes / 1_048_576.0:F1} MB",
			>= 1_024 => $"{SizeBytes / 1_024.0:F1} KB",
			_ => $"{SizeBytes} bytes"
		};
	}
}

<figure>
	@if(!string.IsNullOrWhiteSpace(Model.HeaderImage))
	{
		<img src="@Model.HeaderImage" alt="..." class="hero-image" data-focus="@Model.HeaderImageFocus" />
	}
</figure>
<hgroup>
	@if (!string.IsNullOrWhiteSpace(Model.EyebrowLabel))
	{
		<p class="eyebrow">@Model.EyebrowLabel</p>
	}
	<h1 class="display-title" data-ignore="true">@Html.Raw(Model.DisplayTitleHtml)</h1>
	@if (!string.IsNullOrWhiteSpace(Model.SubtitleText))
	{
		<p class="subtitle">@Model.SubtitleText</p>
	}
</hgroup>

@if (Model.IsViewingCurrentRevision && Model.Revision is not null)
{
	<div class="revision-notice">
		<strong>You are viewing the current revision of this article.</strong><br>
		To see the canonical URL, visit:
		<a href="@Model.CurrentArticlePath">Go to Latest Version</a>
	</div>
}

@if (Model.IsPriorRevision && Model.DisplayedRevision is not null && Model.CurrentRevision is not null)
{
	<div class="revision-notice">
		<strong>You're viewing a prior revision.</strong><br>
		This revision was published on <strong>@Model.DisplayedRevision.DateCreated.ToString("dd MMMM yyyy HH:mm")</strong>.<br>
		The current version was published on <strong>@Model.CurrentRevision.DateCreated.ToString("dd MMMM yyyy HH:mm")</strong>.
		<a href="@Model.CurrentArticlePath">View Current</a>

		@if (Model.HasTitleChanged)
		{
			<p>
				<strong>Note:</strong> The title of this article has changed from
				"<strong>@Model.DisplayedRevision.Title</strong>" to
				"<strong>@Model.CurrentRevision.Title</strong>".
			</p>
		}

		@if (Model.HasUrlSlugChanged)
		{
			<p>
				<strong>Note:</strong> The URL of this article has changed from
				"<strong>@Model.DisplayedCanonicalUrlSlug</strong>" to
				"<strong>@Model.CurrentCanonicalUrlSlug</strong>".<br>
				<a href="@Model.CurrentArticlePath">Go to New URL</a>
			</p>
		}
	</div>
}
else if(Model.DisplayedRevision is not null)
{
	<div class="editor-info">
		@if (Model.RecentAuthors.Count > 0)
		{
			ArticleAuthor PrimaryAuthor = Model.RecentAuthors[0];
			<div class="editor-authors">
				<dl>
					<dt>@(Model.RecentAuthors.Count == 1 ? "Created by" : "Improved by")</dt>
					<dd>
						<a href="/@@@PrimaryAuthor.UserName">@PrimaryAuthor.UserName</a>@if (Model.RecentAuthors.Count > 1)
						{
							<span> &amp; others</span>
						}
					</dd>
				</dl>
				<address>
					@for (int i = 0; i < Model.RecentAuthors.Count; i++)
					{
						ArticleAuthor Author = Model.RecentAuthors[i];
						string? AvatarUrl = Author.ProfilePicGuid.HasValue
							? $"/sitefiles/{Model.SiteId}/profilepics/{Author.ProfilePicGuid.Value}.png"
							: null;
						string Initial = !string.IsNullOrEmpty(Author.UserName)
							? char.ToUpperInvariant(Author.UserName[0]).ToString()
							: "?";

						<a href="/@@@Author.UserName" class="avatar" title="@Author.UserName" style="z-index: @(Model.RecentAuthors.Count - i);">
							@if (!string.IsNullOrWhiteSpace(AvatarUrl))
							{
								<img src="@AvatarUrl" alt="@Author.UserName" />
							}
							else
							{
								<span>@Initial</span>
							}
						</a>
					}
				</address>
			</div>
		}
		@{
			string RawTimeAgo = WikiWikiWorld.Web.Helpers.TimeAgo.GetDetailedTimeAgoString(DateTimeOffset.UtcNow, Model.DisplayedRevision.DateCreated);
			string RelativeTimeText = RawTimeAgo.StartsWith("Updated ", StringComparison.OrdinalIgnoreCase)
				? RawTimeAgo["Updated ".Length..]
				: RawTimeAgo;
			if (RelativeTimeText.Length > 0)
			{
				RelativeTimeText = char.ToUpperInvariant(RelativeTimeText[0]) + RelativeTimeText[1..];
			}
		}
		<dl>
			<dt>Last Updated</dt>
			<dd><time datetime="@Model.DisplayedRevision.DateCreated.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@RelativeTimeText</time></dd>
		</dl>
	</div>
	<div class="article-actions" role="toolbar" aria-label="Article actions">
		<partial name="_Bookmark" model="Model.BookmarkControl" />
		<a href="@Model.TalkPath" class="article-action-talk" rel="nofollow">
			<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
				<use href="@IconSpriteUrl#Discuss"></use>
			</svg>
			<span>@Model.TalkLabel</span>
		</a>
		<div class="m3-split-button">
			<a href="@($"{Model.DisplayedArticlePath}/edit")" rel="nofollow">
				<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
					<use href="@IconSpriteUrl#Edit"></use>
				</svg>
				<span>Edit<span class="action-label-extra"> article</span></span>
			</a>
			<details name="site-menu" class="dropdown-menu">
				<summary aria-label="More article actions">
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
						<use href="@IconSpriteUrl#More"></use>
					</svg>
				</summary>
				<div class="menu-content">
					@if (Model.DisplayedRevision?.Type == WikiWikiWorld.Data.Models.ArticleType.File)
					{
						<a href="@($"{Model.DisplayedArticlePath}/edit#file-upload-section")" rel="nofollow">
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
								<use href="@IconSpriteUrl#Upload"></use>
							</svg>
							<span>Upload new file version</span>
						</a>
					}
					<a href="@($"{Model.DisplayedArticlePath}/history")" rel="nofollow">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<use href="@IconSpriteUrl#History"></use>
						</svg>
						<span>View history</span>
					</a>
					<a href="#">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<use href="@IconSpriteUrl#Watch"></use>
						</svg>
						<span>Watch article</span>
					</a>
					<a href="@($"{Model.DisplayedArticlePath}/links")" rel="nofollow">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<use href="@IconSpriteUrl#Links"></use>
						</svg>
						<span>What links here</span>
					</a>
					<a href="@($"{Model.DisplayedArticlePath}/languages")" rel="nofollow">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<use href="@IconSpriteUrl#Languages"></use>
						</svg>
						<span>Other languages</span>
					</a>
					<a href="#">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<use href="@IconSpriteUrl#Report"></use>
						</svg>
						<span>Report article</span>
					</a>
					<hr />
					<a href="#" class="menu-item-danger">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<use href="@IconSpriteUrl#Delete"></use>
						</svg>
						<span>Delete article</span>
					</a>
				</div>
			</details>
		</div>
	</div>
}

@if (Model.ShowPublicationUploadAside && Model.DisplayedRevision is not null)
{
	<aside class="publication-upload-cta">
		<p>
			Have a copy of this publication you can legally share?
			<a href="/wiki:upload?ArticleSlug=@(Model.DisplayedRevision.UrlSlug)" rel="nofollow">
				Submit it now
			</a>
		</p>
	</aside>
}

<article data-ignore="true">

	@section Scripts {
		<script src="~/js/article-view.js" asp-append-version="true"></script>
		@if (Model.BookmarkControl.IsSignedIn)
		{
			<script type="module" src="~/js/bookmark-notes.js" asp-append-version="true"></script>
		}
		@if (!string.IsNullOrWhiteSpace(Model.HeaderImage))
		{
			<script type="module" src="~/js/header-paper-texture.js" asp-append-version="true"></script>
			<script type="module" src="~/js/search-glass.js" asp-append-version="true"></script>
		}
	}

	@if (Model.DisplayedRevision is not null)
	{
		@if (!string.IsNullOrWhiteSpace(Model.FileImageUrl))
		{
			<section id="file-info-panel">
				<figure>
					<a href="@Model.FileImageUrl">
						<img src="@Model.FileImageUrl"
							 alt="@Model.PlainTextTitle"

							 loading="eager" />
					</a>
				</figure>
				<dl>
					<div>
						<dt>Filename</dt>
						<dd>@Model.FileOriginalFilename</dd>
					</div>
					<div>
						<dt>Type</dt>
						<dd>@Model.FileMimeType</dd>
					</div>
					@if (!string.IsNullOrWhiteSpace(Model.FileCodec))
					{
						<div>
							<dt>Codec</dt>
							<dd>@Model.FileCodec</dd>
						</div>
					}
					@if (Model.FileWidthPx > 0 && Model.FileHeightPx > 0)
					{
						<div>
							<dt>Dimensions</dt>
							<dd>@Model.FileWidthPx &times; @Model.FileHeightPx px</dd>
						</div>
					}
				<div>
					<dt>Size</dt>
					<dd>@FormatFileSize(Model.FileSizeBytes)</dd>
				</div>
				@if (!string.IsNullOrWhiteSpace(Model.FileSourceText))
				{
					<div class="file-source">
						<dt>Source</dt>
						<dd>
							@if (!string.IsNullOrWhiteSpace(Model.FileSourceUrl) && Model.FileSourceText == Model.FileSourceUrl)
							{
								<a href="@Model.FileSourceUrl"
								   rel="@(Model.IsFileSourceApprovedDomain ? "noopener" : "nofollow noopener")"
								   target="_blank">@Model.FileSourceUrl</a>
							}
							else
							{
								@Model.FileSourceText
								@if (!string.IsNullOrWhiteSpace(Model.FileSourceUrl))
								{
									<text>&ensp;</text><a href="@Model.FileSourceUrl"
									   rel="@(Model.IsFileSourceApprovedDomain ? "noopener" : "nofollow noopener")"
									   target="_blank">@Model.FileSourceUrl</a>
								}
							}
						</dd>
					</div>
				}
			</dl>
			<footer>
				<a href="@Model.FileImageUrl" target="_blank" rel="noopener" class="button" data-button-variant="ghost">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
					<span>View Full Resolution</span>
				</a>
				@if (User.Identity?.IsAuthenticated == true)
				{
					<a href="@($"{Model.DisplayedArticlePath}/edit#file-upload-section")" class="button" rel="nofollow">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
							<polyline points="17 8 12 3 7 8"></polyline>
							<line x1="12" y1="3" x2="12" y2="15"></line>
						</svg>
						<span>Upload New Version</span>
					</a>
				}
			</footer>
			</section>

			@if (Model.FileRevisionHistory.Count > 0)
			{
				<section id="file-history-panel">
					<header>
						<div>
							<h2>File History</h2>
							<p>
								@(Model.FileRevisionHistory.Count == 1
									? "1 version recorded for this file."
									: $"{Model.FileRevisionHistory.Count} versions recorded for this file.")
							</p>
						</div>
						@if (User.Identity?.IsAuthenticated == true)
						{
							<a href="@($"{Model.DisplayedArticlePath}/edit#file-upload-section")" class="button" rel="nofollow">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
									<polyline points="17 8 12 3 7 8"></polyline>
									<line x1="12" y1="3" x2="12" y2="15"></line>
								</svg>
								<span>Upload a new version of this file</span>
							</a>
						}
					</header>

					<div>
						@foreach (FileRevisionHistoryItem Rev in Model.FileRevisionHistory)
						{
							<article class="file-history-item @(Rev.IsCurrent ? "is-current" : "")">
								<a href="@Rev.FileImageUrl" target="_blank" rel="noopener" title="View full resolution for revision @Rev.Id">
									<img src="@Rev.FileImageUrl"
										 alt="@Model.PlainTextTitle (Revision @Rev.Id)"

										 loading="lazy" />
								</a>
								<div>
									<header>
										<span class="file-history-badge">
											@(Rev.IsCurrent ? "Current version" : "Previous version")
										</span>
										<time datetime="@Rev.DateCreated.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@Rev.DateCreated.ToString("dd MMMM yyyy, HH:mm")</time>
										@if (!string.IsNullOrWhiteSpace(Rev.CreatedByUserName))
										{
											<span class="file-history-author">
												by <a href="/@@@Rev.CreatedByUserName">@Rev.CreatedByUserName</a>
											</span>
										}
									</header>

									<dl>
										<div>
											<dt>Dimensions</dt>
											<dd>
												@(Rev.ImageWidthPixels.HasValue && Rev.ImageHeightPixels.HasValue
													? $"{Rev.ImageWidthPixels.Value} \u00d7 {Rev.ImageHeightPixels.Value} px"
													: "Unknown")
											</dd>
										</div>
										<div>
											<dt>Codec / Format</dt>
											<dd>@Rev.Codec (@Rev.MimeType)</dd>
										</div>
										<div>
											<dt>File Size</dt>
											<dd>@FormatFileSize(Rev.FileSizeBytes)</dd>
										</div>
										<div>
											<dt>Filename</dt>
											<dd>@Rev.Filename</dd>
										</div>
									</dl>

									@if (!string.IsNullOrWhiteSpace(Rev.RevisionReason))
									{
										<div class="file-history-comment">
											<strong>Comment:</strong>
											@Rev.RevisionReason
										</div>
									}
								</div>
							</article>
						}
					</div>
				</section>
			}
		}

		@Html.Raw(Model.ArticleRevisionHtml)

		@if(Model.IsPriorRevision)
		{
			<p>
				<small>
					Published on: @Model.DisplayedRevision?.DateCreated.ToString("dd MMMM yyyy HH:mm")
				</small>
			</p>
		}

	}
	else
	{
		<p>Article not found.</p>
	}
</article>
