@page
@model WikiWikiWorld.Web.Pages.Article.FirehoseModel
@using WikiWikiWorld.Web.Helpers
@{
	ViewData["Title"] = "Recent Article Revisions";
}

<figure>
	<h1>Firehose</h1>
</figure>

<article>
	<p>Recent changes to the wiki.</p>

	@if (!Model.RecentRevisions.Any())
	{
		<p>No recent revisions found.</p>
	}
	else
	{
		<div class="card card-wide">
			<table>
				<thead>
					<tr>
						<th>Title</th>
						<th>Edited By</th>
						<th>Revision Date</th>
						<th>Reason</th>
					</tr>
				</thead>
				<tbody id="firehose-rows">
					<partial name="_FirehoseRows" model="new WikiWikiWorld.Web.Pages.Article.FirehoseRowsViewModel(Model.RecentRevisions, Model.Users)" />
				</tbody>
			</table>
		</div>

		@* Only offer "Load more" when the first page filled up, i.e. there may be more. *@
		@if (Model.RecentRevisions.Count >= WikiWikiWorld.Web.Pages.Article.FirehoseModel.InitialCount)
		{
			<p class="firehose-load-more">
				<button id="firehose-load-more" type="button" class="button"
						data-url="@Url.Page("Firehose", "Rows")"
						data-skip="@WikiWikiWorld.Web.Pages.Article.FirehoseModel.InitialCount"
						data-page-size="@WikiWikiWorld.Web.Pages.Article.FirehoseModel.LoadMoreCount">
					Load @WikiWikiWorld.Web.Pages.Article.FirehoseModel.LoadMoreCount more
				</button>
			</p>
		}
	}
</article>

@section Scripts {
	<script>
		(() => {
			const Button = document.getElementById("firehose-load-more");
			if (!Button) { return; }

			const Rows = document.getElementById("firehose-rows");
			const PageSize = Number(Button.dataset.pageSize);

			Button.addEventListener("click", async () => {
				Button.disabled = true;

				try {
					const Skip = Number(Button.dataset.skip);
					const Response = await fetch(`${Button.dataset.url}&skip=${Skip}`);

					if (!Response.ok) { return; }

					const Holder = document.createElement("tbody");
					Holder.innerHTML = (await Response.text()).trim();
					const Added = Holder.children.length;

					while (Holder.firstChild) {
						Rows.appendChild(Holder.firstChild);
					}

					Button.dataset.skip = Skip + Added;

					// A short page means we've reached the end.
					if (Added < PageSize) {
						Button.closest(".firehose-load-more").remove();
					}
				} finally {
					Button.disabled = false;
				}
			});
		})();
	</script>
}
