@model WikiWikiWorld.Web.Pages.Article.BookmarkControlModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@{
	string IconSpriteUrl = FileVersions.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/icons.svg"));
	string Label = Model.OtherListCount == 0
		? L["Bookmark lists"]
		: SharedResource.Plural("Bookmark.ListsSavedInOther", Model.OtherListCount);
}
@* Chevron half of the bookmark split button. The badge counts non-default lists holding the article, since the
   leading half only reflects the default list. *@
<summary id="article-bookmark-trigger" aria-label="@Label">
	<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
		<use href="@IconSpriteUrl#ChevronDown"></use>
	</svg>
	@if (Model.OtherListCount > 0)
	{
		<span class="bookmark-menu-badge" aria-hidden="true">@Model.OtherListCount</span>
	}
</summary>
