@page
@using Microsoft.AspNetCore.Identity
@using WikiWikiWorld.Data.Models
@using WikiWikiWorld.Web.Helpers
@inject SignInManager<User> SignInManager
@model WikiWikiWorld.Web.Pages.Article.TalkSubjectsModel
@{
	ViewData["Title"] = L["{0} — Talk", Model.Article?.Title ?? L["Talk"]];
	bool IsSignedIn = SignInManager.IsSignedIn(User);
}

<div class="talk-page">
	<div class="talk-layout">
		<div class="talk-main">
			<header class="talk-page-header">
				<nav class="talk-breadcrumb" aria-label="@L["Breadcrumb"]">
					<a href="@Model.ArticlePath">@Model.Article?.Title</a>
					<span aria-hidden="true">›</span>
					<span>@L["Talk"]</span>
				</nav>
				<h1>@L["Discussion: {0}", Model.Article?.Title ?? string.Empty]</h1>
				<p>@HL["This discussion is public. Use {0} for a private conversation.", UiFormat.Link("/message/new", L["Talk.PrivateMessagesLink"])]</p>
				<p class="talk-page-tag">@SharedResource.Plural("Talk.Subjects", Model.Subjects.Count)</p>
			</header>

			@if (Model.Subjects.Count == 0)
			{
				<p class="talk-empty">@L["No discussion subjects yet. Be the first to start one."]</p>
			}
			else
			{
				<ul class="talk-subject-list">
					@foreach (WikiWikiWorld.Web.Pages.Article.TalkSubjectsModel.SubjectRow Row in Model.Subjects)
					{
						string AuthorName = Model.Authors.TryGetValue(Row.CreatedByUserId, out User? AuthorUser)
							? AuthorUser.UserName ?? L["Unknown"].Value
							: L["Unknown"].Value;
						string SubjectUrl = $"{Model.TalkPath}/{Row.UrlSlug}";
						<li class="talk-subject-row">
							<a class="talk-subject-title" href="@SubjectUrl">@Row.Subject</a>
							<div class="talk-subject-meta">
								<span>@SharedResource.Plural("Talk.Posts", Row.PostCount)</span>
								<span>•</span>
								<span>@HL["by {0}", new Microsoft.AspNetCore.Html.HtmlContentBuilder().AppendHtml("<a class=\"talk-subject-author\" href=\"").Append($"/@{AuthorName}/profile").AppendHtml("\">").Append($"@{AuthorName}").AppendHtml("</a>")]</span>
								<span>•</span>
								<time datetime="@Row.DateCreated.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">
									@TimeAgo.GetDetailedTimeAgoString(DateTimeOffset.UtcNow, Row.DateCreated)
								</time>
							</div>
						</li>
					}
				</ul>
			}

			<section class="talk-new-subject">
				<h2>@L["Start a new subject"]</h2>
				@if (!IsSignedIn)
				{
					<p>
						@HL["{0} to start a discussion.", new Microsoft.AspNetCore.Html.HtmlString($"<a class=\"button\" href=\"/Account/Login\">{System.Net.WebUtility.HtmlEncode(L["Sign in"])}</a>")]
					</p>
				}
				else
				{
					<form method="post" asp-page-handler="NewSubject" asp-route-ArticleSlug="@Model.ArticleSlug">
						<div asp-validation-summary="ModelOnly" class="talk-validation"></div>

						<div class="talk-form-field">
							<label asp-for="Input.Subject">@L["Subject"]</label>
							<input type="text"
							       asp-for="Input.Subject"
							       maxlength="150"
							       required />
							<span asp-validation-for="Input.Subject" class="talk-validation"></span>
						</div>

						<div class="talk-form-field">
							<label asp-for="Input.Text">@L["Your first post (Markdown supported)"]</label>
							<textarea asp-for="Input.Text"
							          rows="5"
							          maxlength="10000"
							          required></textarea>
							<span asp-validation-for="Input.Text" class="talk-validation"></span>
						</div>

						<button type="submit" class="button">@L["Post subject"]</button>
					</form>
				}
			</section>
		</div>

		<partial name="_TalkSidebar" />
	</div>
</div>
