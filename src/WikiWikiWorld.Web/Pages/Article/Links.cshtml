@page
@model WikiWikiWorld.Web.Pages.Article.LinksModel
@{
    ViewData["Title"] = L["Pages that link to \"{0}\"", Model.CurrentArticle?.Title ?? string.Empty];
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="display-title" data-ignore="true">@Html.Raw(Model.DisplayTitleHtml)</h1>
            <p class="lead">
                @L["The following pages link here:"]
            </p>

            @if (Model.Backlinks.Count > 0)
            {
                <ul class="list-group">
                    @foreach (var Link in Model.Backlinks)
                    {
                        <li class="list-group-item">
                            <a href="@WikiWikiWorld.Web.Helpers.ArticleUrlHelper.BuildArticlePath(Link)">@Link.Title</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="alert alert-info">
                    @L["No pages currently link to this article."]
                </div>
            }
            
            <div class="mt-3">
                 <a href="@Model.CanonicalArticlePath" class="btn btn-secondary">@L["Return to Article"]</a>
            </div>
        </div>
    </div>
</div>
