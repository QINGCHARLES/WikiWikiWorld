@* Placeholder sidebar for both talk pages. Stats and house-rules content are not wired yet. *@

<aside class="talk-sidebar" aria-label="@L["About this talk page"]">
	<section class="talk-sidebar-card">
		<h2 class="talk-sidebar-eyebrow">@L["About this talk page"]</h2>
		<p class="talk-sidebar-blurb">
			@L["A space for contributors to coordinate edits, verify facts, and resolve citations."]
		</p>
		<dl class="talk-stats-grid">
			<div class="talk-stat">
				<dt>@L["Topics"]</dt>
				<dd>—</dd>
			</div>
			<div class="talk-stat">
				<dt>@L["Replies"]</dt>
				<dd>—</dd>
			</div>
			<div class="talk-stat">
				<dt>@L["Contributors"]</dt>
				<dd>—</dd>
			</div>
			<div class="talk-stat">
				<dt>@L["Last activity"]</dt>
				<dd>—</dd>
			</div>
		</dl>
	</section>

	<section class="talk-sidebar-card">
		<h2 class="talk-sidebar-eyebrow">@L["House rules"]</h2>
		<ol class="talk-house-rules">
			<li>@L["Cite primary sources where possible."]</li>
			<li>@L["One topic per thread — fork if scope drifts."]</li>
			<li>@L["No edit warring; resolve disputes here first."]</li>
			<li>@L["Tag with the appropriate flair on creation."]</li>
			<li>@L["Be respectful of archivists and original contributors."]</li>
		</ol>
	</section>
</aside>
