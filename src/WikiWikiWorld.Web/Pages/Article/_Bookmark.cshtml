@model WikiWikiWorld.Web.Pages.Article.BookmarkControlModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@{
	string IconSpriteUrl = FileVersions.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/icons.svg"));
}
@if (!Model.IsSignedIn)
{
	@* Anonymous visitors: a single button whose POST answers with a sign-in prompt. *@
	<form id="article-bookmark" method="post" action="@($"{Model.ArticlePath}?handler=SetBookmark&saved=true")" asp-antiforgery="true"
		data-signals="{_bookmarkPending: false, _bookmarkError: ''}">
		<button type="button" aria-pressed="false" disabled
			data-indicator="_bookmarkPending" data-attr:disabled="$_bookmarkPending"
			data-on:click="$_bookmarkError = ''; @@post(el.form.action, {contentType: 'form', retry: 'never', retryMaxCount: 0}).catch(() => { $_bookmarkError = 'Could not save. Reload to check your bookmark before trying again.' })"
			data-on:datastar-fetch__document="if (evt.detail.el === el &amp;&amp; evt.detail.type === 'error') $_bookmarkError = 'Could not save. Reload to check your bookmark before trying again.'">
			<svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
				<use href="@IconSpriteUrl#Bookmark"></use>
			</svg>
			<span>Bookmark</span>
		</button>
		<partial name="_BookmarkStatus" model="@(string.Empty)" />
	</form>
}
else
{
	@* Signed-in users: the leading half toggles the default list; the chevron opens a checkable menu of all lists.
	   Responses patch the toggle, trigger and list elements by id, so the open <details> stays open between toggles. *@
	<form id="article-bookmark" method="post" action="@($"{Model.ArticlePath}?handler=SetBookmark&saved=true")" asp-antiforgery="true" class="m3-split-button"
		data-signals="{_bookmarkPending: false, _bookmarkError: ''}">
		<partial name="_BookmarkToggle" model="Model" />
		<details name="site-menu" class="dropdown-menu">
			<partial name="_BookmarkMenuTrigger" model="Model" />
			<div class="menu-content">
				<partial name="_BookmarkLists" model="Model" />
				<hr />
				<partial name="_BookmarkNewList" model="Model" />
				<a href="@Model.BookmarksPath">
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
						<use href="@IconSpriteUrl#EditLists"></use>
					</svg>
					<span>Edit lists</span>
				</a>
			</div>
		</details>
		<partial name="_BookmarkStatus" model="@(string.Empty)" />
		<partial name="_BookmarkPrompt" model="Model" />
	</form>

	@* One note dialog per page, outside the bookmark form so toggle responses (which patch the menu by id) never replace
	   it. bookmark-notes.js fills it from the chosen row's note button; Save posts it through Datastar and the response
	   refreshes the menu and status. Ctrl+Enter saves; Esc, Cancel or a backdrop click closes without saving. *@
	<dialog id="article-note-dialog" class="bookmark-dialog bookmark-note-dialog" aria-labelledby="article-note-title" closedby="any"
		data-signals="{_noteError: ''}">
		<form method="post" action="@($"{Model.ArticlePath}?handler=SetBookmarkNote")" asp-antiforgery="true"
			data-indicator="_bookmarkPending"
			data-on:submit__prevent="$_noteError = ''; @@post(el.action, {contentType: 'form', retry: 'never', retryMaxCount: 0}).then(() => $_noteError || el.closest('dialog').close()).catch(() => { $_noteError = 'Could not save the note. Check your connection and try again.' })"
			data-on:datastar-fetch__document="if (evt.detail.el === el &amp;&amp; evt.detail.type === 'error') $_noteError = 'Could not save the note. Check your connection and try again.'">
			<input type="hidden" name="BookmarkId" value="" />
			<div class="bookmark-editor-context">
				<div class="bookmark-editor-head">
					<p class="bookmark-editor-list" id="article-note-eyebrow">Bookmarks</p>
					<span class="bookmark-editor-visibility" id="article-note-visibility" data-public="false">
						<svg data-when-public="false" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><use href="@IconSpriteUrl#Lock"></use></svg>
						<svg data-when-public="true" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><use href="@IconSpriteUrl#Globe"></use></svg>
						<span data-when-public="false">Private<span class="visually-hidden"> list. Only you can see this note.</span></span>
						<span data-when-public="true">Public<span class="visually-hidden"> list. Anyone can read this note.</span></span>
					</span>
				</div>
				@if (!string.IsNullOrEmpty(Model.ArticleTitle))
				{
					<p class="bookmark-editor-subject">@Model.ArticleTitle</p>
				}
			</div>
			<h2 class="bookmark-editor-title" id="article-note-title">Add a note</h2>
			<label class="visually-hidden" for="article-note-text">Note</label>
			<textarea id="article-note-text" name="Notes" maxlength="@WikiWikiWorld.Data.Models.Bookmark.MaxNotesLength" rows="4"
				aria-describedby="article-note-help article-note-visibility"></textarea>
			<p class="bookmark-editor-help" id="article-note-help">
				<span>Markdown supported</span>
				<span class="bookmark-editor-count" data-count-for="article-note-text" aria-hidden="true"></span>
			</p>
			<div class="bookmark-error" role="alert" data-text="$_noteError"></div>
			<div class="bookmark-editor-actions">
				<button type="button" class="bookmark-editor-button" data-variant="danger-quiet" data-bookmark-note-delete="true">Delete note</button>
				<button type="button" class="bookmark-editor-button" commandfor="article-note-dialog" command="close">Cancel</button>
				<button type="submit" class="bookmark-editor-button" data-variant="primary" data-attr:disabled="$_bookmarkPending">Save note</button>
			</div>
		</form>
	</dialog>
}
