@page
@model WikiWikiWorld.Web.Pages.Article.DeleteModel
@{
	ViewData["Title"] = L["Title.DeleteArticle"];
}

<figure></figure>
<hgroup>
	<h1>@L["Title.DeleteArticle"]</h1>
</hgroup>

<article class="delete-article">
	<h2>@L["Delete “{0}”?", Model.ArticleTitle]</h2>
	<p>@L["Deleting hides the article and its history from readers, and its address stops working. Only a site administrator can restore it."]</p>

	<form method="post">
		<input type="hidden" asp-for="UrlSlug" />
		<div class="form-actions">
			<button type="submit" class="button" data-button-variant="negative">@L["Delete article"]</button>
			<a href="@Model.ArticlePath" class="button" data-button-variant="ghost">@L["Cancel"]</a>
		</div>
	</form>
</article>

<style>
	.delete-article .form-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block-start: 1.5rem;
	}
</style>
