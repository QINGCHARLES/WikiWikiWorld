@page
@using Microsoft.AspNetCore.Identity
@using WikiWikiWorld.Data.Models
@using WikiWikiWorld.Web.Helpers
@inject SignInManager<User> SignInManager
@model WikiWikiWorld.Web.Pages.Article.TalkSubjectModel
@{
	ViewData["Title"] = (Model.Subject?.Subject ?? "Talk") + " — " + (Model.Article?.Title ?? "Talk");
	bool IsSignedIn = SignInManager.IsSignedIn(User);
	string CreatorName = Model.Subject is not null && Model.Authors.TryGetValue(Model.Subject.CreatedByUserId, out User? CreatorUser)
		? CreatorUser.UserName ?? "Unknown"
		: "Unknown";
	int PostCount = CountPosts(Model.PostTree);
}

<div class="talk-page">
	<div class="talk-layout">
		<div class="talk-main">
			<header class="talk-page-header">
				<nav class="talk-breadcrumb" aria-label="Breadcrumb">
					<a href="@Model.ArticlePath">@Model.Article?.Title</a>
					<span aria-hidden="true">›</span>
					<a href="@Model.TalkListPath">Talk</a>
					<span aria-hidden="true">›</span>
					<span>@Model.Subject?.Subject</span>
				</nav>
				<h1>@Model.Subject?.Subject</h1>
				<div class="talk-subject-meta">
					<span>Started by <a class="talk-subject-author" href="/@@@CreatorName/profile">@@@CreatorName</a></span>
					@if (Model.Subject is not null)
					{
						<span>•</span>
						<time datetime="@Model.Subject.DateCreated.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">
							@TimeAgo.GetDetailedTimeAgoString(DateTimeOffset.UtcNow, Model.Subject.DateCreated)
						</time>
					}
					<span>•</span>
					<span>@PostCount @(PostCount == 1 ? "post" : "posts")</span>
				</div>
			</header>

			<section class="talk-thread">
				@if (Model.PostTree.Count == 0)
				{
					<p class="talk-empty">This subject has no posts.</p>
				}
				else
				{
					@foreach (WikiWikiWorld.Web.Pages.Article.TalkSubjectModel.PostNode Root in Model.PostTree)
					{
						WikiWikiWorld.Web.Pages.Article._TalkSubjectPostContext RootContext = new()
						{
							Node = Root,
							Depth = 0,
							Authors = Model.Authors,
							ArticleSlug = Model.ArticleSlug,
							SubjectSlug = Model.SubjectSlug,
						};
						<partial name="_TalkSubjectPost" model="@RootContext" />
					}
				}
			</section>

			<section class="talk-new-reply">
				<h2>Reply to this subject</h2>
				@if (!IsSignedIn)
				{
					<p>
						<a class="button" href="/Account/Login">Sign in</a> to reply.
					</p>
				}
				else
				{
					<form method="post" asp-page-handler="Reply">
						<div asp-validation-summary="ModelOnly" class="talk-validation"></div>
						<div class="md3-field md3-filled">
							<textarea asp-for="Input.Text"
							          placeholder=" "
							          rows="4"
							          maxlength="10000"
							          required></textarea>
							<label asp-for="Input.Text">Reply (Markdown supported)</label>
							<span class="md-line"></span>
						</div>
						<span asp-validation-for="Input.Text" class="talk-validation"></span>
						<button type="submit" class="button">Post reply</button>
					</form>
				}
			</section>
		</div>

		<partial name="_TalkSidebar" />
	</div>
</div>

@functions {
	private static int CountPosts(IReadOnlyList<WikiWikiWorld.Web.Pages.Article.TalkSubjectModel.PostNode> Nodes)
	{
		int Total = 0;
		foreach (WikiWikiWorld.Web.Pages.Article.TalkSubjectModel.PostNode Node in Nodes)
		{
			Total += 1 + CountPosts(Node.Children);
		}
		return Total;
	}
}
