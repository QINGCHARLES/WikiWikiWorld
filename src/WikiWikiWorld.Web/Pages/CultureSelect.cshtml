@page
@model WikiWikiWorld.Web.Pages.CultureSelectModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.SiteName</title>
    <link rel="stylesheet" href="/css/core/colors.css" />
    <link rel="stylesheet" href="/css/core/variables.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--color-culture-bg-start) 0%, var(--color-culture-bg-mid) 50%, var(--color-culture-bg-end) 100%);
            color: var(--color-white);
        }
        h1 {
            font-size: 3rem;
            font-weight: 300;
            letter-spacing: 0.3em;
            margin-bottom: 2rem;
            text-transform: uppercase;
        }
        .languages {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
        .languages a {
            color: var(--color-white);
            text-decoration: none;
            font-size: 1.25rem;
            padding: 0.75rem 2rem;
            border: 1px solid rgb(var(--color-white-rgb) / 0.2);
            border-radius: 8px;
            transition: all 0.2s ease;
        }
        .languages a:hover {
            background: rgb(var(--color-white-rgb) / 0.1);
            border-color: rgb(var(--color-white-rgb) / 0.4);
        }
    </style>
</head>
<body>
    <h1>@Model.SiteName</h1>
    <nav class="languages">
        @foreach (WikiWikiWorld.Web.Pages.CultureLink CultureLink in Model.CultureLinks)
        {
            @* lang/hreflang mark the link as being in its own language; dir="auto" lets the
               browser infer direction per item, so Arabic renders RTL beside LTR entries. *@
            <a href="@CultureLink.Url" hreflang="@CultureLink.CultureCode" lang="@CultureLink.CultureCode" dir="auto">@CultureLink.DisplayName</a>
        }
    </nav>
</body>
</html>
