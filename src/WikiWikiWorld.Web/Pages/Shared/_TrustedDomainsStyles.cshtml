@* Styles shared by the members' trusted-domains page and the administrators' review queue (scoped to .trusted-domains). *@
<style>
	.trusted-domains {
		& section {
			margin-block-end: 2.5rem;
		}

		& form > label,
		& form > p > label {
			display: block;
			font-weight: 600;
			margin-block-end: 0.35rem;
		}

		& input[type="text"],
		& textarea {
			box-sizing: border-box;
			inline-size: 100%;
			padding: 0.6rem 0.8rem;
			border: 2px solid var(--color-border-subtle);
			border-radius: 0.4rem;
			font: inherit;
			font-size: var(--step-0);
		}

		& textarea {
			resize: vertical;
			min-block-size: 5rem;
		}

		& .form-help {
			font-size: var(--step--1);
			color: var(--color-muted);
			line-height: 1.4;
		}

		& [role="alert"],
		& [role="status"] {
			padding: 0.75rem 1rem;
			border-radius: 0.4rem;
			border: 2px solid;
			margin-block-end: 1.25rem;
		}

		& [role="status"] {
			background: var(--color-brand-lime-surface);
			border-color: var(--color-brand-lime-hover);
			color: var(--color-hyperlinks);
		}

		& [role="alert"] {
			background: var(--color-danger-surface);
			border-color: var(--color-danger-bright);
			color: var(--color-danger-text);
		}

		/* Each pending proposal in the review queue. */
		& .proposal {
			border: 2px solid var(--color-border);
			border-radius: 0.75rem;
			padding: 1.25rem 1.5rem;
			margin-block-end: 1.25rem;

			& h3 {
				margin-block-start: 0;
			}

			& dl {
				display: grid;
				grid-template-columns: max-content 1fr;
				gap: 0.25rem 1rem;
			}

			& dd {
				margin: 0;
			}

			& blockquote {
				margin-inline: 0;
				padding-inline-start: 1rem;
				border-inline-start: 4px solid var(--color-border);
				white-space: pre-line;
			}
		}

		& .form-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-block-start: 0.75rem;
		}

		& td > form {
			display: grid;
			gap: 0.5rem;
			min-inline-size: 12rem;
		}

		& .note {
			white-space: pre-line;
		}

		& .domain-list {
			columns: 14rem;
			padding-inline-start: 1.25rem;
		}
	}
</style>
