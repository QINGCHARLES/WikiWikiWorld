@model BasePageModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@using Microsoft.AspNetCore.Identity
@using WikiWikiWorld.Data.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject WikiWikiWorld.Web.Services.SiteStylesheetCatalog Stylesheets
@inject WikiWikiWorld.Web.Infrastructure.PermissionService Permissions
@inject WikiWikiWorld.Web.Services.TrustedLinkDomainService TrustedDomains
@{
	string IconSpriteUrl = FileVersions.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/icons.svg"));
	string? PreferredThemeValue = (ViewData["PreferredTheme"] as string)?.ToLowerInvariant();
	string? DataTheme = PreferredThemeValue switch
	{
		"light" => "light",
		"dark" => "dark",
		_ => null
	};
	// The document language follows the culture subdomain; the culture-selector root has none and stays English.
	string DocumentLanguage = string.IsNullOrWhiteSpace(Model.Culture) ? "en" : Model.Culture;
	string? DocumentDirection = WikiWikiWorld.Web.Helpers.SiteCultureHelper.IsRightToLeft(DocumentLanguage) ? "rtl" : null;
}
<!doctype html>
<html lang="@DocumentLanguage" dir="@DocumentDirection" data-theme="@DataTheme">
<head>

<link rel="preload" href="/fonts/LyonTextWeb-RegularNoTwo.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/LyonDisplayWeb-Black.woff2" as="font" type="font/woff2" crossorigin>

    <meta charset="utf-8" />
	@* Keep both directives (re: https://news.ycombinator.com/item?id=36112889): width=device-width sets the layout viewport width to the device width across all engines and orientations, while initial-scale=1 locks the initial visual zoom to 1:1 so minor horizontal overflow in wiki content induces scrolling rather than zooming out the entire page. *@
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - @(!string.IsNullOrWhiteSpace(Model.SiteName) ? Model.SiteName : "Magazedia")</title>
	<link rel="stylesheet" href="https://use.typekit.net/kwb1ind.css">
	@foreach (string StylesheetPath in Stylesheets.GetPaths(Model.SiteId))
	{
		<link rel="stylesheet" href="@StylesheetPath" asp-append-version="true" />
	}
	@if (!string.IsNullOrWhiteSpace(Model.MetaDescription))
	{
		<meta name="description" content="@Model.MetaDescription" />
	}
	@if (!Model.AllowSearchEngineIndexingOfPage)
	{
		<meta name="robots" content="noindex">
	}

	@await RenderSectionAsync("PageHead", required: false)

	@* <script defer src="https://cloud.umami.is/script.js" data-website-id="2681fe66-d481-4722-9df1-b50b7aa0010c"></script> *@
	@* Analytics run only on the production English Magazedia host, so dev, other cultures and other sites send nothing. *@
	@if (string.Equals(Context.Request.Host.Host, "en.magazedia.com", StringComparison.OrdinalIgnoreCase))
	{
		<script defer src="https://stats.magazedia.com/core.js" data-website-id="80f32dd9-f045-45c1-b758-ae0faee7efb6"></script>
	}

</head>
<body>
	<script async src="https://cse.google.com/cse.js?cx=d2fb19070cd0c4f3d"></script>
	<header>
		<nav class="header">
			<a class="logo" href="/">
				<img class="logo-svg" src="/sitefiles/@(Model.SiteId > 0 ? Model.SiteId : 1)/logo.svg" alt="@(!string.IsNullOrWhiteSpace(Model.SiteName) ? Model.SiteName : "Magazedia")" />
			</a>
			<form class="search-form" action="/Search" method="get" role="search" data-count-text="@System.Text.Json.JsonSerializer.Serialize(SharedResource.PluralForms("Search.SuggestionsAvailable"))">
				<button class="search-submit" type="submit" aria-label="@L["Search articles"]">
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m16.5 16.5 4 4" /></svg>
				</button>
				<input id="header-search-input" type="search" name="q" aria-label="@L["Search articles"]" enterkeyhint="search" autocomplete="off"
					data-on:input__debounce.180ms="el.value.trim().length >= 2 &amp;&amp; @@get('/Search?handler=suggestions&amp;q=' + encodeURIComponent(el.value.trim()), {filterSignals: {include: /^$/}, retry: 'never', retryMaxCount: 0})" />
				<div id="search-suggestions" class="search-suggestions" data-ignore="true" hidden></div>
				<span id="search-suggestions-status" class="visually-hidden" role="status"></span>
			</form>
			<div class="header-b">
				@if (SignInManager.IsSignedIn(User))
				{
					WikiWikiWorld.Data.Models.User? CurrentUser = await UserManager.GetUserAsync(User);
					string UserName = CurrentUser?.UserName ?? User?.Identity?.Name ?? "profile";
					int SiteId = Model?.SiteId ?? 0;
					if (SiteId <= 0)
					{
						SiteId = 1;
					}
					string ProfileUrl = $"/@{UserName}/profile";
					string? ProfilePicGuid = CurrentUser?.ProfilePicGuid?.ToString();
					string? AvatarPath = !string.IsNullOrWhiteSpace(ProfilePicGuid)
						? Url.Content($"~/sitefiles/{SiteId}/profilepics/{ProfilePicGuid}.png")
						: null;
					string AvatarInitial = !string.IsNullOrEmpty(UserName)
						? char.ToUpperInvariant(UserName[0]).ToString()
						: "?";
					// Administrators see how many trusted-domain proposals wait for review, on the avatar and in the menu.
					bool CanReviewDomains = await Permissions.HasPermissionAsync(User!, WikiWikiWorld.Web.Infrastructure.Permission.ReviewTrustedLinkDomains, Context.RequestAborted);
					bool CanUseAdminTools = await Permissions.HasPermissionAsync(User!, WikiWikiWorld.Web.Infrastructure.Permission.UseAdminTools, Context.RequestAborted);
					int PendingDomainCount = CanReviewDomains ? await TrustedDomains.CountPendingAsync(Context.RequestAborted) : 0;
					string AccountMenuLabel = PendingDomainCount > 0
						? L["Account menu for {0}, {1}", UserName, SharedResource.Plural("AccountMenu.PendingTrustedDomains", PendingDomainCount)]
						: L["Account menu for {0}", UserName];
					<details name="site-menu" class="dropdown-menu account-menu">
						<summary class="account-menu-trigger" aria-label="@AccountMenuLabel">
							<span class="avatar header-avatar" aria-hidden="true">
								@if (!string.IsNullOrWhiteSpace(AvatarPath))
								{
									<img src="@AvatarPath" alt="" width="44" height="44" />
								}
								else
								{
									<span class="avatar-initials">@AvatarInitial</span>
								}
							</span>
							@if (PendingDomainCount > 0)
							{
								<span class="account-menu-count" aria-hidden="true">@PendingDomainCount</span>
							}
						</summary>
						<div class="menu-content">
							<a href="@ProfileUrl">
							<span class="avatar account-menu-avatar" aria-hidden="true">
								@if (!string.IsNullOrWhiteSpace(AvatarPath))
								{
									<img src="@AvatarPath" alt="" width="44" height="44" />
								}
								else
								{
									<span class="avatar-initials">@AvatarInitial</span>
								}
							</span>
								<span class="account-menu-profile">@L["View My Profile"]<small>@UserName</small></span>
							</a>
							<a href="@($"/@{UserName}/contributions")"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><use href="@IconSpriteUrl#Contributions"></use></svg><span>@L["My Contributions"]</span></a>
							<a href="@($"/@{UserName}/bookmarks")"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><use href="@IconSpriteUrl#Bookmarks"></use></svg><span>@L["My Bookmarks"]</span></a>
							<a href="@($"/@{UserName}/messages")"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><use href="@IconSpriteUrl#Messages"></use></svg><span>@L["Messages"]</span></a>
							<a href="@($"/@{UserName}/notifications")"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><use href="@IconSpriteUrl#Notifications"></use></svg><span>@L["Notifications"]</span></a>
							@if (CanUseAdminTools)
							{
								<a asp-page="/Admin/Users"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><use href="@IconSpriteUrl#Lock"></use></svg><span>@L["Manage users"]</span></a>
							}
							@if (CanReviewDomains)
							{
								<a href="/Admin/TrustedDomains">
									<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><use href="@IconSpriteUrl#Links"></use></svg><span>@L["Trusted domains"]</span>
									@if (PendingDomainCount > 0)
									{
										<span class="account-menu-count">@PendingDomainCount<span class="visually-hidden"> @L["waiting"]</span></span>
									}
								</a>
							}
							else
							{
								<a href="/wiki:trusted-domains"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><use href="@IconSpriteUrl#Links"></use></svg><span>@L["Trusted domains"]</span></a>
							}
							<hr />
							<a href="@($"/@{Uri.EscapeDataString(UserName)}/settings")"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><use href="@IconSpriteUrl#Settings"></use></svg><span>@L["Settings"]</span></a>
							<hr />
							<a href="/Account/Logout"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><use href="@IconSpriteUrl#LogOut"></use></svg><span>@L["Log Out"]</span></a>
						</div>
					</details>
				}
				else
				{
					<a class="button" href="/Account/Login" data-button-variant="naked">@L["Log In"]</a>
					<a class="button" href="/Account/Register">@L["Contribute"]</a>
				}
@* 				<partial name="_LoginPartial" /> *@
			</div>
		</nav>
	</header>
	<main role="main">
		@RenderBody()
	</main>
	<partial name="@(Model?.SiteId == 4 ? "~/Pages/Shared/Sites/Cinepedia/_Footer.cshtml" : "~/Pages/Shared/_Footer.cshtml")" />

	<script type="module" src="~/js/vendor/datastar-1.0.4.js" asp-append-version="true"></script>
	<script src="~/js/dropdown-menu.js" asp-append-version="true"></script>
	<script src="~/js/search-dropdown.js" asp-append-version="true"></script>
	<script src="~/js/carousel.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
