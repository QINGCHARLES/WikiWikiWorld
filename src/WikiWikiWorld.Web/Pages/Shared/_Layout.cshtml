</head>
<body>
	<script async src="https://cse.google.com/cse.js?cx=d2fb19070cd0c4f3d"></script>
	<header>
		<nav class="header">
			<a class="logo" href="/">
				<svg class="logo-svg" viewBox="1 -57 55 58"><path fill="#3f1" d="M1.51-14.11L11.88-55.51L13.39-54.00L3.10-12.53L1.51-14.11ZM33.55-20.45L53.06-43.06L54.65-41.47L44.28 0L42.70-1.58L51.84-38.23L49.10-35.06L41.11-3.17L39.60-4.68L46.37-31.90L43.63-28.73L38.02-6.26L36.43-7.85L40.82-25.49L38.16-22.39L34.92-9.36L33.34-10.94L35.35-19.22L34.42-18.07L33.41-19.01L31.75-12.53L30.17-14.11L31.82-20.66L32.76-19.73L25.56-39.89L25.13-38.23L31.32-21.17L29.74-22.75L24.70-36.58L24.34-34.92L28.15-24.34L26.64-25.85L23.90-33.34L23.47-31.75L25.06-27.43L23.47-29.02L23.11-30.10L15.62 0L14.04-1.58L24.41-42.98L25.92-41.47L26.64-39.46L40.61-55.51L42.12-54.00L27.50-37.01L28.37-34.70L43.70-52.42L45.22-50.90L29.23-32.33L30.10-29.95L46.80-49.32L48.38-47.74L30.96-27.58L31.82-25.13L49.90-46.22L51.48-44.64L32.69-22.82L33.55-20.45ZM4.61-11.02L14.98-52.42L16.56-50.83L6.19-9.43L4.61-11.02ZM7.78-7.85L18.14-49.25L19.66-47.74L9.36-6.26L7.78-7.85ZM10.87-4.75L21.24-46.15L22.82-44.57L12.46-3.17L10.87-4.75Z" /></svg>
			</a>
			<form class="search-form" action="/Search" method="get" role="search">
				<button class="search-submit" type="submit" aria-label="Search articles">
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m16.5 16.5 4 4" /></svg>
				</button>
				<input id="header-search-input" type="search" name="q" aria-label="Search articles" enterkeyhint="search" autocomplete="off"
					data-on:input__debounce.180ms="el.value.trim().length >= 2 &amp;&amp; @@get('/Search?handler=suggestions&amp;q=' + encodeURIComponent(el.value.trim()), {filterSignals: {include: /^$/}, retry: 'never', retryMaxCount: 0})" />
				<div id="search-suggestions" class="search-suggestions" data-ignore="true" hidden></div>
				<span id="search-suggestions-status" class="visually-hidden" role="status"></span>
			</form>
			<div class="header-b">
				@if (SignInManager.IsSignedIn(User))
				{
					WikiWikiWorld.Data.Models.User? CurrentUser = await UserManager.GetUserAsync(User);
					string UserName = CurrentUser?.UserName ?? User?.Identity?.Name ?? "profile";
					int SiteId = Model?.SiteId ?? 0;
					if (SiteId <= 0)
					{
						SiteId = 1;
					}
					string ProfileUrl = $"/@{UserName}/profile";
					string? ProfilePicGuid = CurrentUser?.ProfilePicGuid?.ToString();
					string? AvatarPath = !string.IsNullOrWhiteSpace(ProfilePicGuid)
						? Url.Content($"~/sitefiles/{SiteId}/profilepics/{ProfilePicGuid}.png")
						: null;
					string AvatarInitial = !string.IsNullOrEmpty(UserName)
						? char.ToUpperInvariant(UserName[0]).ToString()
						: "?";
					<details name="site-menu" class="dropdown-menu account-menu">
						<summary class="menu-trigger account-menu-trigger" aria-label="Account menu for @UserName">
							<span class="avatar header-avatar" aria-hidden="true">
								@if (!string.IsNullOrWhiteSpace(AvatarPath))
								{
									<img src="@AvatarPath" alt="" width="44" height="44" />
								}
								else
								{
									<span class="avatar-initials">@AvatarInitial</span>
								}
							</span>
						</summary>
						<div class="menu-content">
							<a href="@ProfileUrl">
							<span class="avatar account-menu-avatar" aria-hidden="true">
								@if (!string.IsNullOrWhiteSpace(AvatarPath))
								{
									<img src="@AvatarPath" alt="" width="44" height="44" />
								}
								else
								{
									<span class="avatar-initials">@AvatarInitial</span>
								}
							</span>
								<span class="account-menu-profile">View My Profile<small>@UserName</small></span>
							</a>
							<a href="@($"/@{UserName}/contributions")"><svg class="menu-item-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 3 5 5-12 12-6 1 1-6Z" /><path d="m14 5 5 5" /></svg><span>My Contributions</span></a>
							<a href="@($"/@{UserName}/bookmarks")"><svg class="menu-item-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4Z" /></svg><span>My Bookmarks</span></a>
							<a href="@($"/@{UserName}/messages")"><svg class="menu-item-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11a8 8 0 0 1-8 8H7l-4 3V11a9 9 0 0 1 18 0Z" /><path d="M7 9h10M7 13h7" /></svg><span>Messages</span></a>
							<a href="@($"/@{UserName}/notifications")"><svg class="menu-item-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" /><path d="M10 21h4M12 2V1" /></svg><span>Notifications</span></a>
							<hr class="menu-divider" />
							<a href="@($"/@{Uri.EscapeDataString(UserName)}/settings")"><svg class="menu-item-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 3-1 3-3 1-2 4 2 2v4l4 3 3-1 3 1 4-3v-4l2-2-2-4-3-1-1-3Z" /><circle cx="12" cy="12" r="3" /></svg><span>Settings</span></a>
							<hr class="menu-divider" />
							<a href="/Account/Logout"><svg class="menu-item-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H4V3h5M14 7l5 5-5 5M8 12h11" /></svg><span>Log Out</span></a>
						</div>
					</details>
				}
				else
				{
					<a class="button" href="/Account/Login" data-button-variant="naked">Log In</a>
					<a class="button" href="/Account/Register">Contribute</a>
				}
@* 				<partial name="_LoginPartial" /> *@
			</div>
		</nav>
	</header>
