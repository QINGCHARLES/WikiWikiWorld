@model BasePageModel
@using Microsoft.AspNetCore.Identity
@using WikiWikiWorld.Data.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject WikiWikiWorld.Web.Services.SiteStylesheetCatalog Stylesheets
@{
	string? PreferredThemeValue = (ViewData["PreferredTheme"] as string)?.ToLowerInvariant();
	string? DataTheme = PreferredThemeValue switch
	{
		"light" => "light",
		"dark" => "dark",
		_ => null
	};
}
<!doctype html>
<html lang="en" data-theme="@DataTheme">
<head>

<link rel="preload" href="/fonts/LyonTextWeb-RegularNoTwo.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/LyonDisplayWeb-Black.woff2" as="font" type="font/woff2" crossorigin>

    <meta charset="utf-8" />
	@* Keep both directives (re: https://news.ycombinator.com/item?id=36112889): width=device-width sets the layout viewport width to the device width across all engines and orientations, while initial-scale=1 locks the initial visual zoom to 1:1 so minor horizontal overflow in wiki content induces scrolling rather than zooming out the entire page. *@
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Magazedia</title>
	<link rel="stylesheet" href="https://use.typekit.net/kwb1ind.css">
	@foreach (string StylesheetPath in Stylesheets.GetPaths(Model.SiteId))
	{
		<link rel="stylesheet" href="@StylesheetPath" asp-append-version="true" />
	}
	@if (!string.IsNullOrWhiteSpace(Model.MetaDescription))
	{
		<meta name="description" content="@Model.MetaDescription" />
	}
	@if (!Model.AllowSearchEngineIndexingOfPage)
	{
		<meta name="robots" content="noindex">
	}

@* 	<meta name="dcterms.created" content="2025-03-05T08:54:00Z">
	<meta property="article:published_time" content="2025-03-05T08:54:00Z">
 *@
@* 	<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "Article",
		  "headline": "Your Article Title",
		  "datePublished": "2025-03-05T08:54:00Z",
		  "author": {
			"@type": "Person",
			"name": "Author Name"
		  }
		  // Additional properties
		}
	</script> *@
@* 	Ensure your website's XML sitemap includes the
	<lastmod> tag for each URL, indicating the last modification date. *@

