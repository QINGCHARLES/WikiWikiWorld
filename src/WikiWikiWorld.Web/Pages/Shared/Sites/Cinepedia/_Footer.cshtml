	</nav>
	<small>@HL["Content is available under {0} unless otherwise noted.", new Microsoft.AspNetCore.Html.HtmlString("<a href=\"https://creativecommons.org/licenses/by-sa/4.0/\">CC BY-SA 4.0</a>")]</small>
</footer>
