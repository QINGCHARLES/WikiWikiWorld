<footer>
	<p><a href="/">Cinepedia</a> &mdash; @L["The film encyclopedia"]</p>
	<nav aria-label="@L["Footer links"]">
		<a href="/Search">@L["Search"]</a>
		<a href="/info:sitemap">@L["Sitemap"]</a>
		<a href="/privacy-policy:">@L["Privacy Policy"]</a>
