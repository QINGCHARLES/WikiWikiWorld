@page
@model IndexModel
@{
	ViewData["Title"] = L["Home page"];
}

<figure>
	<h1>@Model.SiteName</h1>
</figure>

<nav class="home-categories" aria-label="@L["Categories"]">
	<ul class="home-category-list" role="list">
		<li><a href="/" aria-current="page">@L["All"]</a></li>
		@foreach (HomeCategory Category in IndexModel.Categories)
		{
			<li><a href="/category:@Category.Slug">@L[Category.Title]</a></li>
		}
	</ul>
	<details class="home-categories-toggle">
		<summary>
			<span class="home-categories-more">@L["All categories"]</span>
			<span class="home-categories-less">@L["Show less"]</span>
			<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
		</summary>
	</details>
</nav>

<article>
	@if (Model.ArticlesWithCovers.Any())
	{
		<div class="home-cover-grid">
			@foreach (ArticleWithCover Article in Model.ArticlesWithCovers)
			{
				<a href="/@Article.UrlSlug" class="@(Article.IsHeaderImage ? "cover-item cover-item--header" : "cover-item")">
					<img src="@Article.ImageUrl" alt="@Article.Title" data-focus="@Article.ImageFocus" />
					<div class="cover-title">@Article.Title</div>
				</a>
			}
		</div>
	}
	else
	{
		<p>@L["No articles with cover images found."]</p>
	}

	<p style="margin-top: 2rem;">
		<a href="/create:">@L["Create New Article"]</a><br />
		<a href="/firehose:">@L["View the Firehose"]</a><br />
	</p>
</article>
