@page
@model WikiWikiWorld.Web.Pages.SearchModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Q) ? L["Search"] : L["Search: {0}", Model.Q];
}

<h1>@L["Search"]</h1>

@if (string.IsNullOrWhiteSpace(Model.Q))
{
    <p>@L["Enter a search term to find articles."]</p>
}
else if (Model.SearchResults.Count == 0)
{
    <p>@HL["No results found for \"{0}\".", UiFormat.Strong(Model.Q)]</p>
}
else
{
    <p>@HL[SharedResource.PluralPattern("Search.ResultsFound", Model.SearchResults.Count), Model.SearchResults.Count, UiFormat.Strong(Model.Q)]</p>
    <ul class="search-results">
        @foreach (ArticleSearchResult result in Model.SearchResults)
        {
            <li class="search-result-item">
                <a href="@result.Path">@Html.Raw(Model.HighlightTerm(result.Title))</a>
                @if (result.Type == ArticleType.Redirect)
                {
                    <span class="search-suggestion-type">@L["Redirect"]</span>
                }
                @if (!result.IsTitleMatch && !string.IsNullOrWhiteSpace(result.Snippet))
                {
                    <p class="search-snippet">@Html.Raw(Model.HighlightTerm(result.Snippet))</p>
                }
            </li>
        }
    </ul>
}
