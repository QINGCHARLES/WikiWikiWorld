@page
@model WikiWikiWorld.Web.Pages.Profile.ContributionsModel
@{
	ProfileHeader Header = Model.Header;
	ProfileContributionPage Contributions = Model.Contributions;
	ViewData["Title"] = L["{0} · Contributions", Header.UserName];
	DateTimeOffset Now = DateTimeOffset.UtcNow;
	string BasePath = $"/@{Header.UserName}/contributions";
	int FirstNumber = ((Contributions.PageNumber - 1) * ContributionsModel.PageSize) + 1;
}

<div class="profile">
	<partial name="_ProfileHeader" model="new WikiWikiWorld.Web.Pages.Profile.ProfileHeaderView(Header, ProfileTab.Contributions)" />

	<div class="profile-stack">
		<partial name="_ProfileCalendar" model="Model.Calendar" />

		<section class="profile-card" aria-labelledby="profile-history-title">
			<header class="profile-card-head">
				<h2 class="profile-card-title" id="profile-history-title">@L["Edit history"]</h2>
				@if (Contributions.Items.Count > 0)
				{
					<p class="profile-card-note">
						@L["{0}–{1} of {2}", FirstNumber.ToString("N0", CultureInfo.CurrentCulture), (FirstNumber + Contributions.Items.Count - 1).ToString("N0", CultureInfo.CurrentCulture), Header.Stats.EditCount.ToString("N0", CultureInfo.CurrentCulture)]
					</p>
				}
			</header>

			@if (Contributions.Items.Count == 0)
			{
				<p class="profile-card-empty">
					@if (Contributions.PageNumber > 1)
					{
						@HL["There are no older edits. {0}.", UiFormat.Link(BasePath, L["Back to the newest"])]
					}
					else
					{
						@(Header.IsOwner ? L["You haven't edited any articles yet."] : L["{0} hasn't edited any articles yet.", Header.UserName])
					}
				</p>
			}
			else
			{
				@foreach (IGrouping<(int Year, int Month), ProfileActivityItem> Month in Contributions.Items.GroupBy(i => (i.Date.UtcDateTime.Year, i.Date.UtcDateTime.Month)))
				{
					DateTime MonthStart = new(Month.Key.Year, Month.Key.Month, 1, 0, 0, 0, DateTimeKind.Utc);
					<h3 class="profile-month">@UiFormat.Format(MonthStart, "MMMM yyyy", CultureInfo.CurrentCulture, "Y")</h3>
					<ol class="profile-list">
						@foreach (ProfileActivityItem Item in Month)
						{
							<li class="profile-list-row">
								<span class="profile-kind" data-kind="@Item.Kind.ToString().ToLowerInvariant()">@(Item.Kind == ProfileActivityKind.Created ? L["Created"] : L["Edited"])</span>
								<div class="profile-list-main">
									<a class="profile-list-title" href="@Item.Path" rel="nofollow">@Item.Title</a>
									@if (!string.IsNullOrWhiteSpace(Item.Summary))
									{
										<p class="profile-list-meta">@Item.Summary</p>
									}
								</div>
								<time class="profile-list-time" datetime="@Item.Date.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)" title="@UiFormat.Format(Item.Date.UtcDateTime, "f", CultureInfo.CurrentCulture, "f") UTC">@ProfileFormatting.ToRelativeTime(Item.Date, Now)</time>
							</li>
						}
					</ol>
				}
			}

			@if (Contributions.PageNumber > 1 || Contributions.HasNextPage)
			{
				<nav class="profile-pager" aria-label="@L["Edit history pages"]">
					@if (Contributions.PageNumber > 1)
					{
						<a href="@(Contributions.PageNumber == 2 ? BasePath : $"{BasePath}?pagenumber={(Contributions.PageNumber - 1).ToString(CultureInfo.InvariantCulture)}")" rel="prev"><span aria-hidden="true">@L["Arrow.Back"]</span> @L["Newer"]</a>
					}
					<span class="profile-pager-current">@L["Page {0}", Contributions.PageNumber.ToString("N0", CultureInfo.CurrentCulture)]</span>
					@if (Contributions.HasNextPage)
					{
						<a href="@BasePath?pagenumber=@((Contributions.PageNumber + 1).ToString(CultureInfo.InvariantCulture))" rel="next">@L["Older"] <span aria-hidden="true">@L["Arrow.Forward"]</span></a>
					}
				</nav>
			}
		</section>
	</div>
</div>

@section Scripts {
	<script src="~/js/profile.js" asp-append-version="true" defer></script>
}
