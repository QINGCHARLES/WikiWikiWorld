@model WikiWikiWorld.Web.Pages.Profile.ProfileHeaderView
@{
	ProfileHeader Header = Model.Header;
	ProfileStats Stats = Header.Stats;
	DateTimeOffset Now = DateTimeOffset.UtcNow;
	string Initial = Header.UserName.Length > 0 ? char.ToUpperInvariant(Header.UserName[0]).ToString() : "?";
	string Volume = ProfileFormatting.ToRomanNumeral(Math.Clamp(Header.VolumeNumber, 1, 3999));
	int YearsAsMember = Header.VolumeNumber - 1;
	string EditArticleUrl = Header.HasProfileArticle
		? $"{Header.ArticlePath}/edit"
		: $"/Article/CreateEdit?UrlSlug={Uri.EscapeDataString(Header.ArticlePath.TrimStart('/'))}";
	string ShareUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Header.ProfilePath}";

	// Razor omits an attribute whose value is null, so only the current tab carries aria-current.
	string? TabCurrent(ProfileTab Tab) => Tab == Model.ActiveTab ? "page" : null;
}
<header class="profile-masthead" aria-labelledby="profile-name">
	<div class="profile-cover">
		<p class="profile-kicker">
			<span>Profile</span>
			@if (Header.DateJoined is { } Established)
			{
				<span>Est. @Established.ToString("yyyy", CultureInfo.InvariantCulture)</span>
			}
			<span>@Header.Rank</span>
		</p>

		<div class="profile-cover-title">
			<p class="profile-volume" title="Volume @Header.VolumeNumber: year @Header.VolumeNumber as a member">
				<span class="profile-volume-label">Vol.</span>
				<span class="profile-volume-number">@Volume</span>
				<span class="visually-hidden">, @(YearsAsMember == 0 ? "a member for under a year" : YearsAsMember == 1 ? "a member for a year" : $"a member for {YearsAsMember} years")</span>
			</p>
			@if (!string.IsNullOrWhiteSpace(Header.Tagline))
			{
				<blockquote class="profile-epigraph">
					<p>@Header.Tagline</p>
				</blockquote>
			}
		</div>

		<div class="profile-cover-foot">
			<dl class="profile-coverlines">
				<div>
					<dt>Edits</dt>
					<dd>@Stats.EditCount.ToString("N0", CultureInfo.CurrentCulture)</dd>
				</div>
				<div>
					<dt>Articles started</dt>
					<dd>@Stats.ArticlesStartedCount.ToString("N0", CultureInfo.CurrentCulture)</dd>
				</div>
				<div>
					<dt>Articles edited</dt>
					<dd>@Stats.ArticlesEditedCount.ToString("N0", CultureInfo.CurrentCulture)</dd>
				</div>
				<div>
					<dt>Talk posts</dt>
					<dd>@Stats.TalkPostCount.ToString("N0", CultureInfo.CurrentCulture)</dd>
				</div>
			</dl>
			<div class="profile-barcode" aria-hidden="true">
				<span class="profile-barcode-bars"></span>
				<span class="profile-barcode-number">No. @Stats.EditCount.ToString("D4", CultureInfo.InvariantCulture)</span>
			</div>
		</div>
	</div>

	<div class="profile-identity">
		<span class="avatar profile-avatar">
			@if (!string.IsNullOrWhiteSpace(Header.AvatarPath))
			{
				<img src="@Header.AvatarPath" alt="" width="144" height="144" />
			}
			else
			{
				<span class="avatar-initials" aria-hidden="true">@Initial</span>
			}
		</span>

		<div class="profile-identity-text">
			<h1 class="profile-name" id="profile-name">@Header.UserName</h1>
			<ul class="profile-facts">
				<li class="profile-rank">@Header.Rank</li>
				@foreach (string Role in Header.Roles)
				{
					<li class="profile-role">@Role</li>
				}
				@if (Header.DateJoined is { } Joined)
				{
					<li>Joined <time datetime="@Joined.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)">@Joined.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</time></li>
				}
				@if (Header.LastActive is { } LastActive)
				{
					<li>Active <time datetime="@LastActive.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)">@ProfileFormatting.ToRelativeTime(LastActive, Now)</time></li>
				}
			</ul>
			@if (!string.IsNullOrWhiteSpace(Header.Summary))
			{
				<p class="profile-summary">@Header.Summary</p>
			}
		</div>

		<div class="profile-actions">
			<button type="button" class="button profile-share" data-button-variant="ghost" data-share-url="@ShareUrl" data-share-title="@Header.UserName" hidden>
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"></path>
					<path d="m16 6-4-4-4 4"></path>
					<path d="M12 2v13"></path>
				</svg>
				<span class="profile-share-label">Share</span>
			</button>
			@if (Header.IsOwner)
			{
				<a href="@EditArticleUrl" class="button profile-action-accent" rel="nofollow">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
						<path d="m15 5 4 4"></path>
					</svg>
					<span>@(Header.HasProfileArticle ? "Edit profile" : "Write your profile")</span>
				</a>
			}
			else if (Header.IsViewerAuthenticated)
			{
				<a href="/@@@Header.UserName/message/new" class="button profile-action-accent" rel="nofollow">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="2" y="4" width="20" height="16" rx="2"></rect>
						<path d="m22 6-10 7L2 6"></path>
					</svg>
					<span>Message</span>
				</a>
			}
			<span class="profile-share-status visually-hidden" role="status"></span>
		</div>
	</div>
</header>

<nav class="profile-tabs" aria-label="Profile sections">
	<ul>
		<li>
			<a href="@Header.ProfilePath" aria-current="@TabCurrent(ProfileTab.Overview)">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="8" r="4"></circle>
					<path d="M4 21a8 8 0 0 1 16 0"></path>
				</svg>
				Profile
			</a>
		</li>
		<li>
			<a href="/@@@Header.UserName/contributions" aria-current="@TabCurrent(ProfileTab.Contributions)">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
					<path d="M3 3v5h5"></path>
					<path d="M12 7v5l3 2"></path>
				</svg>
				Contributions
				<span class="profile-tab-count">@Stats.EditCount.ToString("N0", CultureInfo.CurrentCulture)</span>
			</a>
		</li>
		@if (Header.IsOwner)
		{
			<li>
				<a href="/@@@Header.UserName/bookmarks" aria-current="@TabCurrent(ProfileTab.Bookmarks)">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
					</svg>
					Bookmarks
					@if (Header.BookmarkCount is { } BookmarkCount)
					{
						<span class="profile-tab-count">@BookmarkCount.ToString("N0", CultureInfo.CurrentCulture)</span>
					}
				</a>
			</li>
			<li>
				<a href="/@@@Header.UserName/messages" aria-current="@TabCurrent(ProfileTab.Messages)">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 21l1.9-5.5a9 9 0 0 1-.9-4A8.5 8.5 0 0 1 12.5 3h.5a8.5 8.5 0 0 1 8 8v.5Z"></path>
					</svg>
					Messages
				</a>
			</li>
			@* Watchlists have no storage yet; the tab previews the planned section without linking anywhere. *@
			<li>
				<span class="profile-tab-soon" aria-disabled="true" title="Watchlists are coming soon">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
						<circle cx="12" cy="12" r="3"></circle>
					</svg>
					Watchlist
					<span class="profile-tab-count">Soon</span>
				</span>
			</li>
			<li>
				<a href="/settings/theme:">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M2 14h4M10 8h4M18 16h4"></path>
					</svg>
					Settings
				</a>
			</li>
		}
	</ul>
</nav>
