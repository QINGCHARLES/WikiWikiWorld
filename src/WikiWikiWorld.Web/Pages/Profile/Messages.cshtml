@page
@model WikiWikiWorld.Web.Pages.Profile.MessagesModel
@{
	ViewData["Title"] = $"{Model.Header.UserName} · Messages";
	string BasePath = $"/@{Model.Header.UserName}/messages";
	string FolderPath = Model.Tab == "sent" ? $"{BasePath}/sent" : BasePath;
	DateTimeOffset Now = DateTimeOffset.UtcNow;
}
<div class="profile">
	<partial name="_ProfileHeader" model="new WikiWikiWorld.Web.Pages.Profile.ProfileHeaderView(Model.Header, ProfileTab.Messages)" />
	<section class="profile-card" aria-labelledby="messages-title">
		<h2 id="messages-title" class="profile-card-title">Private messages</h2>
		<nav aria-label="Message folders">
			<a href="@BasePath" aria-current="@(Model.Tab == "inbox" ? "page" : null)">Inbox</a> ·
			<a href="@BasePath/sent" aria-current="@(Model.Tab == "sent" ? "page" : null)">Started by you</a> ·
			<a href="/message/new">New conversation</a>
		</nav>
		<p class="profile-card-note">Only participants can open a conversation. Public user-page discussions are separate.</p>
		@if (Model.Folder.Items.Count == 0)
		{
			<p class="profile-card-empty">No conversations in this folder.</p>
		}
		else
		{
			<ul class="profile-list">
				@foreach (PrivateConversationItem Conversation in Model.Folder.Items)
				{
					<li class="profile-list-row">
						<div class="profile-list-main">
							<a class="profile-list-title" href="/message/@Conversation.Id.ToString("D")">@Conversation.Subject</a>
							<p class="profile-list-meta">Started by @Conversation.CreatorName</p>
						</div>
						<time class="profile-list-time" datetime="@Conversation.LastMessageDate.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)">@ProfileFormatting.ToRelativeTime(Conversation.LastMessageDate, Now)</time>
					</li>
				}
			</ul>
		}
		@if (Model.Folder.PageCount > 1)
		{
			<nav class="profile-pager" aria-label="Message folder pages">
				@if (Model.Folder.PageNumber > 1)
				{
					<a href="@FolderPath?pagenumber=@(Model.Folder.PageNumber - 1)" rel="prev">Previous</a>
				}
				<span>Page @Model.Folder.PageNumber of @Model.Folder.PageCount</span>
				@if (Model.Folder.PageNumber < Model.Folder.PageCount)
				{
					<a href="@FolderPath?pagenumber=@(Model.Folder.PageNumber + 1)" rel="next">Next</a>
				}
			</nav>
		}
	</section>
</div>
@section Scripts {
	<script src="~/js/profile.js" asp-append-version="true" defer></script>
}
