		[
			"gq.com",
			"rollingstone.com",
			"theverge.com",
			"vogue.com",
			"vanityfair.com",
			"theatlantic.com",
			"wired.com"
		],
		"Sites":
		[
			{
				"SiteId": 1,
				"SiteName": "Magazedia",
				"PrivacyContactEmail": "privacy@magazedia.com",
				"RootDomainIsCultureSelectorOnly": true,
