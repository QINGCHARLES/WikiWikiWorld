{
	"DetailedErrors": true,
	"ConnectionStrings": {
		"DefaultConnection": "Data Source=/app/data/app.db"
	},
	"JwtSettings": {
		"Issuer": "WikiWikiWorld",
		"Audience": "WikiWikiWorld"
	},
	"ApplicationStartup": {
		"DataPath": "/app/data"
	},
	"DomainRedirects": {
		"StripWww": true,
		"HostMappings": {
			"magazedia.wiki": "magazedia.com"
		},
		"UnknownHostTarget": "en.magazedia.com"
	},
	"Kestrel": {
		"Endpoints": {
		"HttpsInlineCertAndKeyFile": {
			"Url": "https://[::]:443",
			"Certificate": {
			"Path": "/app/certs/cert.pem",
			"KeyPath": "/app/certs/key.pem"
			}
		},
		"Http": {
			"Url": "http://[::]:80"
		}
		}
	},
	"ContentDeliveryNetworkSettings": {
		"BaseUrl": "https://static.magazedia.com"
	},
	"SiteConfiguration": {
