# OS/editor noise
.DS_Store
*.swp
*.*~
*.pyc

# User-specific IDE state
.vs/
# Ignore the .vscode contents, not the directory itself: git cannot re-include a file
# whose parent directory is excluded, so ".vscode/" would defeat the negation below and
# tasks.json (which holds the build/deploy pipeline) would stay untracked.
.vscode/*
!.vscode/tasks.json
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
artifacts/
publish/
*.binlog
msbuild.log
msbuild.err
msbuild.wrn

# Test output
TestResults/
*.trx
*.coverage
*.coveragexml

# Packages
*.nupkg
*.snupkg
**/packages/*
node_modules/
project.lock.json
project.fragment.lock.json

# Local .NET/tool state
.dotnet/

# Local runtime data
data/
*.db
*.db-shm
*.db-wal

# Logs
*.log

# Certificates and secrets
*.pfx
*.p12
*.pem
*.key
*.crt
appsettings.Development.json
secrets.json

# Retired agent/tool state
.claude/
